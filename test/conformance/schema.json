{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheetwrite.vercel.app/schemas/conformance-v1.json",
  "title": "Sheetwrite original-evidence compatibility test set",
  "type": "object",
  "required": ["protocol", "license", "cases"],
  "additionalProperties": false,
  "properties": {
    "protocol": { "const": 1 },
    "license": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "scalar": { "type": ["null", "boolean", "number", "string"] },
    "result": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "blank",
            "boolean",
            "number",
            "string",
            "error",
            "array",
            "workbook",
            "unsupported"
          ]
        },
        "value": {},
        "error": { "type": "string", "minLength": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "displayedText": { "type": "string" },
        "formula": { "type": "string" },
        "tolerance": {
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["absolute", "relative", "ulp"] },
            "value": { "type": "number", "minimum": 0 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": { "required": ["value"], "properties": { "value": { "type": "number" } } }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } } },
          "then": { "required": ["value"], "properties": { "value": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "then": { "required": ["value"], "properties": { "value": { "type": "string" } } }
        },
        {
          "if": { "properties": { "type": { "const": "error" } } },
          "then": { "required": ["error"], "not": { "required": ["value"] } }
        },
        {
          "if": { "properties": { "type": { "const": "array" } } },
          "then": {
            "required": ["value", "rows", "columns"],
            "properties": { "value": { "type": "array" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "workbook" } } },
          "then": { "required": ["value"], "properties": { "value": { "type": "object" } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["blank", "unsupported"] } } },
          "then": { "not": { "anyOf": [{ "required": ["value"] }, { "required": ["error"] }] } }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": ["title", "section", "url", "sha256", "license", "authorship"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "license": { "type": "string", "minLength": 1 },
        "authorship": { "enum": ["original", "spec-derived", "producer-observation"] },
        "notice": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "basis", "oracle"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["property", "metamorphic", "pinned-observation"] },
        "basis": {
          "enum": ["documented-semantics", "property-invariant", "producer-observation"]
        },
        "oracle": { "type": "string", "minLength": 1 }
      }
    },
    "caseTolerance": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "exact" } }
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["absolute", "relative", "ulp"] },
            "value": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "required": ["producer", "producerVersion", "capturedAt", "status"],
      "additionalProperties": false,
      "properties": {
        "producer": {
          "enum": ["excel-desktop", "excel-web", "google-sheets", "libreoffice", "sheetwrite"]
        },
        "producerVersion": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["reviewed", "provisional", "unavailable"] },
        "result": { "$ref": "#/$defs/result" },
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["reviewed", "provisional"] } } },
          "then": { "required": ["result", "artifactSha256"] }
        },
        {
          "if": { "properties": { "status": { "const": "unavailable" } } },
          "then": { "required": ["notes"], "not": { "required": ["result"] } }
        }
      ]
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "area",
        "dialect",
        "category",
        "family",
        "kind",
        "source",
        "evidence",
        "tolerance",
        "expected",
        "observations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "area": { "enum": ["formula", "mutation", "workbook", "xlsx"] },
        "feature": { "type": "string", "minLength": 1 },
        "dialect": { "enum": ["shared", "excel", "google-sheets", "openformula"] },
        "category": {
          "enum": ["normal", "empty", "mixed", "error", "boundary", "range-array", "mutation"]
        },
        "family": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["formula", "mutation", "workbook"] },
        "subject": {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["function", "operator"] },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "source": { "$ref": "#/$defs/source" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "tolerance": { "$ref": "#/$defs/caseTolerance" },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cell", "value"],
            "additionalProperties": false,
            "properties": {
              "cell": { "type": "string", "pattern": "^[A-Z]+[1-9][0-9]*$" },
              "value": { "$ref": "#/$defs/scalar" }
            }
          }
        },
        "numberFormat": { "type": "string", "minLength": 1 },
        "formula": { "type": "string", "pattern": "^=" },
        "target": { "type": "string", "pattern": "^[A-Z]+[1-9][0-9]*$" },
        "operations": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "expected": { "$ref": "#/$defs/result" },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
        "knownDivergence": {
          "type": "object",
          "required": ["reason", "producers", "alternate"],
          "additionalProperties": false,
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "producers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["excel-desktop", "excel-web", "google-sheets", "libreoffice"]
              }
            },
            "alternate": { "$ref": "#/$defs/result" }
          }
        },
        "unsupported": { "type": "boolean" },
        "localCanary": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "formula" } } },
          "then": { "required": ["subject", "inputs", "formula", "target"] }
        },
        {
          "if": { "properties": { "kind": { "enum": ["mutation", "workbook"] } } },
          "then": { "required": ["feature", "operations"] }
        },
        {
          "if": { "properties": { "kind": { "const": "mutation" } } },
          "then": { "properties": { "category": { "const": "mutation" } } }
        },
        {
          "if": { "properties": { "unsupported": { "const": true } }, "required": ["unsupported"] },
          "then": {
            "properties": {
              "expected": {
                "properties": { "type": { "const": "unsupported" } },
                "required": ["type"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expected": {
                "properties": { "type": { "const": "unsupported" } },
                "required": ["type"]
              }
            },
            "required": ["expected"]
          },
          "then": {
            "required": ["unsupported"],
            "properties": { "unsupported": { "const": true } }
          }
        }
      ]
    }
  }
}

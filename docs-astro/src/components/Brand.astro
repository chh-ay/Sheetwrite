---
import { withBasePath } from "../base-path.js";

interface Props {
  compact?: boolean;
  href?: string;
}

const { compact = false, href = "/" } = Astro.props;
const route = withBasePath(href, import.meta.env.BASE_URL);
---

<a class:list={["sw-brand", { "sw-brand--compact": compact }]} href={route} aria-label="Sheetwrite home">
  <svg viewBox="0 0 28 28" aria-hidden="true">
    <rect x="1" y="1" width="26" height="26" rx="3"></rect>
    <path d="M4 10h20M4 18h20M10 4v20M18 4v20"></path>
  </svg>
  <span>Sheetwrite</span>
</a>

<style>
  .sw-brand {
    display: inline-flex;
    min-width: max-content;
    align-items: center;
    gap: 0.7rem;
    color: var(--sw-fg-strong, #f8fafc);
    font-family: var(--sw-font-display, system-ui), sans-serif;
    font-size: var(--sw-type-sm);
    font-weight: 650;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .sw-brand svg {
    width: 1.55rem;
    height: 1.55rem;
    fill: var(--sw-surface-3, #111827);
    stroke: var(--sw-accent, #34d399);
    stroke-linecap: round;
    stroke-width: 1.45;
  }

  .sw-brand--compact span {
    display: none;
  }
</style>

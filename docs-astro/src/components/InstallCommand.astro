---
import { Check, Copy, PackageCheck } from "lucide-astro";

interface Props {
  packageName: string;
}

const { packageName } = Astro.props;
const command = `bun add ${packageName}`;
---

<figure class="sw-install-card" data-install-command={command} aria-label={`${packageName} installation`}>
  <figcaption class="sw-install-card__heading">
    <PackageCheck aria-hidden="true" size={18} strokeWidth={1.8} />
    <span>Install the adapter</span>
  </figcaption>
  <div class="sw-install-card__command">
    <pre><code><span>bun add</span> <span>{packageName}</span></code></pre>
    <button type="button" aria-label={`Copy ${command}`}>
      <Copy class="sw-install-card__copy" aria-hidden="true" size={16} />
      <Check class="sw-install-card__check" aria-hidden="true" size={16} />
      <span>Copy</span>
    </button>
  </div>
</figure>

<script>
  async function copyInstallCommand(value: string): Promise<void> {
    if (!navigator.clipboard) throw new Error("Clipboard API unavailable");
    await navigator.clipboard.writeText(value);
  }

  for (const card of document.querySelectorAll<HTMLElement>("[data-install-command]")) {
    if (card.dataset.copyReady === "true") continue;
    card.dataset.copyReady = "true";
    const button = card.querySelector<HTMLButtonElement>("button");
    button?.addEventListener("click", async () => {
      const command = card.dataset.installCommand;
      if (!command) return;
      const label = button.querySelector("span");
      try {
        await copyInstallCommand(command);
        button.dataset.copied = "true";
        delete button.dataset.copyError;
        if (label) label.textContent = "Copied";
        button.setAttribute("aria-label", `Copied ${command}`);
      } catch {
        button.dataset.copyError = "true";
        if (label) label.textContent = "Copy failed";
        button.setAttribute("aria-label", `Could not copy ${command}`);
      }
      window.setTimeout(() => {
        delete button.dataset.copied;
        delete button.dataset.copyError;
        if (label) label.textContent = "Copy";
        button.setAttribute("aria-label", `Copy ${command}`);
      }, 1600);
    });
  }
</script>

<style>
  .sw-install-card {
    width: min(24rem, 100%);
    margin: 0;
    border: 1px solid var(--color-ink-700);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-ink-900) 88%, transparent);
    box-shadow: 0 1.25rem 4rem rgb(0 0 0 / 18%);
  }

  .sw-install-card__heading,
  .sw-install-card__command {
    display: flex;
    align-items: center;
  }

  .sw-install-card__heading {
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--color-ink-700);
    color: var(--color-ink-200);
    font-size: var(--sw-type-sm);
    font-weight: 650;
  }

  .sw-install-card__heading > svg {
    flex: none;
    color: var(--framework-accent, var(--color-brand-400));
  }

  .sw-install-card__command {
    gap: 0.75rem;
    justify-content: space-between;
    padding: 0.75rem;
    background: color-mix(in srgb, var(--color-ink-950) 88%, transparent);
  }

  .sw-install-card__command pre {
    min-width: 0;
    margin: 0;
    overflow-x: auto;
  }

  .sw-install-card__command code {
    color: var(--color-ink-300);
    font: 500 var(--sw-type-sm) / 1.6 var(--font-mono);
    white-space: nowrap;
  }

  .sw-install-card__command code span:last-child {
    color: var(--framework-accent, var(--color-brand-300));
  }

  .sw-install-card__command button {
    display: inline-flex;
    min-height: 2.25rem;
    gap: 0.45rem;
    align-items: center;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-ink-600);
    border-radius: 0.5rem;
    background: var(--color-ink-800);
    color: var(--color-ink-200);
    font: 600 var(--sw-type-sm) var(--font-sans);
    cursor: pointer;
  }

  .sw-install-card__command button:hover {
    border-color: var(--framework-accent, var(--color-brand-500));
    color: var(--color-ink-50);
  }

  .sw-install-card__check,
  .sw-install-card__command button[data-copied="true"] .sw-install-card__copy {
    display: none;
  }

  .sw-install-card__command button[data-copied="true"] .sw-install-card__check {
    display: block;
    color: var(--framework-accent, var(--color-brand-400));
  }

  .sw-install-card__command button[data-copy-error="true"] {
    border-color: #ef4444;
    color: #fca5a5;
  }


  @media (max-width: 48rem) {
    .sw-install-card {
      width: 100%;
    }
  }
</style>

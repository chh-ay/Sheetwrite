---
import { withBasePath } from "../base-path.js";
import Brand from "./Brand.astro";

interface Props {
  active?: string;
}

const { active = "" } = Astro.props;
const route = (path: string) => withBasePath(path, import.meta.env.BASE_URL);
const examples = [
  { id: "vanilla", label: "Core", href: "/vanilla/" },
  { id: "react", label: "React", href: "/react/" },
  { id: "vue", label: "Vue", href: "/vue/" },
  { id: "svelte", label: "Svelte", href: "/svelte/" },
];
---

<header class="sw-product-nav">
  <Brand />
  <nav aria-label="Product navigation">
    <a href={route("/docs/start/installation/")}>Docs</a>
    <a class="sw-product-nav__examples" href={route("/vanilla/")}>Examples</a>
    {examples.map((example) => (
      <a
        class:list={[
          "sw-product-nav__framework",
          { "is-active": active === example.id },
        ]}
        href={route(example.href)}
        aria-current={active === example.id ? "page" : undefined}
      >
        {example.label}
      </a>
    ))}
  </nav>
  <a
    class="sw-product-nav__github"
    href="https://github.com/chh-ay/Sheetwrite"
    aria-label="Sheetwrite on GitHub"
  >
    GitHub
  </a>
</header>

<style>
  .sw-product-nav {
    z-index: 30;
    display: grid;
    height: 4rem;
    flex: none;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: stretch;
    gap: 1.5rem;
    padding-inline: clamp(1rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--sw-border, #202b40);
    background: color-mix(in srgb, var(--sw-surface-0, #05070d) 92%, transparent);
    backdrop-filter: blur(18px);
  }

  .sw-product-nav :global(.sw-brand) {
    align-self: center;
  }

  .sw-product-nav nav {
    display: flex;
    min-width: 0;
    align-items: stretch;
    justify-content: center;
    gap: 0.25rem;
  }

  .sw-product-nav nav a,
  .sw-product-nav__github {
    position: relative;
    display: inline-flex;
    min-width: max-content;
    align-items: center;
    padding-inline: 0.8rem;
    color: var(--sw-fg-muted, #94a3b8);
    font-size: var(--sw-type-sm);
    font-weight: 600;
    text-decoration: none;
    transition: color 140ms ease;
  }

  .sw-product-nav nav a:hover,
  .sw-product-nav__github:hover,
  .sw-product-nav nav a.is-active {
    color: var(--sw-fg-strong, #f8fafc);
  }

  .sw-product-nav nav a.is-active::after {
    position: absolute;
    right: 0.75rem;
    bottom: -1px;
    left: 0.75rem;
    height: 2px;
    background: var(--sw-accent, #34d399);
    content: "";
  }

  .sw-product-nav__examples {
    display: none !important;
  }

  @media (max-width: 48rem) {
    .sw-product-nav {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.7rem;
      padding-inline: 1rem;
    }

    .sw-product-nav :global(.sw-brand span),
    .sw-product-nav__github,
    .sw-product-nav__framework:not(.is-active) {
      display: none;
    }

    .sw-product-nav nav {
      justify-content: flex-end;
    }

    .sw-product-nav__examples {
      display: inline-flex !important;
    }
  }
</style>

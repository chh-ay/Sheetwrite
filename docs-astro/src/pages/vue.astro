---
import ShowcasePage from "@/components/ShowcasePage.astro";
import VueConsole from "@/components/VueConsole";
---

<ShowcasePage
  active="vue"
  eyebrow="VUE / STREAMING OPERATIONS"
  title="Navigate a million-row workbook without loading it all."
  description="A Vue application backed by a request-aware datasource. Only the visible window and overscan are cached while editing, search, remote mutation acknowledgement, and sheet controls stay live."
  packageName="@sheetwrite/vue"
  guide="/docs/frameworks/vue/"
  sourcePath="docs/src/components/VueConsole.ts"
  proof={[
    { icon: "database", title: "Windowed datasource", detail: "One million rows are paged only for the visible range." },
    { icon: "search", title: "Scroll to match", detail: "Search selects and reveals results inside the live grid." },
    { icon: "refresh", title: "Durable sync", detail: "Mutation IDs survive delayed acknowledgement and retry." },
    { icon: "workflow", title: "Vue bindings", detail: "Refs and events expose one Grid without copied document state." },
  ]}
>
  <VueConsole client:only="vue" />
</ShowcasePage>

---
import HeroWorkbook from "@/components/HeroWorkbook";
import Layout from "@/layouts/Layout.astro";
import { withBasePath } from "../base-path.js";

const route = (path: string) => withBasePath(path, import.meta.env.BASE_URL);
const integrations = [
  {
    name: "Core",
    accent: "#f0b429",
    description: "Own the DOM lifecycle directly and compose the full imperative Grid API.",
    href: "/vanilla/",
  },
  {
    name: "React",
    accent: "#61dafb",
    description: "Forwarded refs, explicit readiness generations, and production-safe resets.",
    href: "/react/",
  },
  {
    name: "Vue",
    accent: "#42b883",
    description: "Exposed Grid state, kebab-case events, and paged datasource workflows.",
    href: "/vue/",
  },
  {
    name: "Svelte",
    accent: "#ff3e00",
    description: "Bindable Grid ownership, callbacks, formulas, and custom renderer composition.",
    href: "/svelte/",
  },
] as const;
---

<Layout
  title="Sheetwrite — spreadsheet infrastructure for the web"
  description="A production spreadsheet engine with a Rust/WASM columnar core, canvas rendering, and first-class React, Vue, and Svelte adapters."
>
  <main class="sw-home">
    <section class="sw-home-hero">
      <div class="sw-home-hero__copy">
        <span class="sw-kicker">RUST / WASM / CANVAS</span>
        <h1>A spreadsheet engine for products that outgrow tables.</h1>
        <p>
          Ship editing, formulas, search, sort, filters, collaboration primitives, and XLSX without
          turning every cell into a DOM component.
        </p>
        <div class="sw-home-actions">
          <a class="is-primary" href={route("/docs/start/installation/")}>Build your first grid</a>
          <a href="https://github.com/chh-ay/Sheetwrite">View source</a>
        </div>
        <dl class="sw-home-proof">
          <div><dt>100k</dt><dd>live rows below</dd></div>
          <div><dt>6</dt><dd>public packages</dd></div>
          <div><dt>4</dt><dd>integration paths</dd></div>
        </dl>
      </div>
      <div class="sw-home-hero__demo">
        <HeroWorkbook client:only="react" />
      </div>
    </section>

    <section class="sw-home-principles" aria-labelledby="principles-title">
      <header>
        <span class="sw-kicker">ONE ENGINE, CLEAR OWNERSHIP</span>
        <h2 id="principles-title">Built as infrastructure, not a widget pile.</h2>
      </header>
      <div class="sw-home-principles__grid">
        <article>
          <span>01</span>
          <h3>Columnar state</h3>
          <p>Typed columns, packed windows, Rust scans, and explicit query capabilities keep scale honest.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Canvas presentation</h3>
          <p>One renderer contract serves the main thread and Worker path without per-cell DOM churn.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Host-owned lifecycle</h3>
          <p>Core and adapters expose readiness, resets, events, persistence, and sync as explicit contracts.</p>
        </article>
      </div>
    </section>

    <section class="sw-home-integrations" aria-labelledby="integrations-title">
      <header>
        <span class="sw-kicker">RUN THE REAL PRODUCT</span>
        <h2 id="integrations-title">Same engine. Four ownership models.</h2>
        <p>Each showcase is a production build with real editing and data—not a screenshot or DOM mock.</p>
      </header>
      <div class="sw-home-integrations__grid">
        {integrations.map((integration) => (
          <a href={route(integration.href)} style={`--integration-accent:${integration.accent}`}>
            <span>{integration.name}</span>
            <p>{integration.description}</p>
            <strong>Open showcase →</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="sw-home-cta">
      <div>
        <span class="sw-kicker">START WITH THE CONTRACT</span>
        <h2>Install the engine. Choose ownership later.</h2>
      </div>
      <a href={route("/docs/start/installation/")}>Read installation</a>
    </section>

    <footer class="sw-home-footer">
      <span>Sheetwrite</span>
      <span>MIT licensed</span>
      <nav aria-label="Footer links">
        <a href={route("/docs/reference/compatibility-limits/")}>Compatibility</a>
        <a href={route("/docs/api/")}>API</a>
        <a href="https://github.com/chh-ay/Sheetwrite/blob/develop/SECURITY.md">Security</a>
      </nav>
    </footer>
  </main>
</Layout>

<style>
  .sw-home {
    flex: 1;
    overflow-y: auto;
    background:
      radial-gradient(circle at 12% 8%, rgb(52 211 153 / 10%), transparent 30rem),
      var(--sw-surface-0, #070a12);
  }

  .sw-home-hero {
    display: grid;
    min-height: calc(100svh - 4rem);
    grid-template-columns: minmax(18rem, 0.75fr) minmax(36rem, 1.25fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding: clamp(2.5rem, 5vh, 4rem) clamp(1.25rem, 5vw, 5rem);
    border-bottom: 1px solid var(--sw-border, #202b40);
  }

  .sw-home-hero__copy {
    max-width: 43rem;
  }

  .sw-kicker {
    color: var(--sw-accent, #34d399);
    font: 650 var(--sw-type-xs) var(--sw-font-mono, monospace);
    letter-spacing: 0.16em;
  }

  .sw-home h1,
  .sw-home h2,
  .sw-home h3,
  .sw-home p {
    margin-block-start: 0;
  }

  .sw-home h1 {
    margin-block: 0.9rem 1.25rem;
    color: var(--sw-fg-strong, #f8fafc);
    font: 650 clamp(2.75rem, 4.5vw, 4.75rem) / 0.98 var(--sw-font-display, system-ui);
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .sw-home-hero__copy > p {
    max-width: 35rem;
    color: var(--sw-fg-muted, #91a4c1);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.7;
  }

  .sw-home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-block: 2rem;
  }

  .sw-home-actions a,
  .sw-home-cta > a {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    justify-content: center;
    padding-inline: 1.1rem;
    border: 1px solid var(--sw-border-strong, #33445f);
    border-radius: 0.65rem;
    color: var(--sw-fg-strong, #f8fafc);
    font-size: var(--sw-type-sm);
    font-weight: 650;
    text-decoration: none;
  }

  .sw-home-actions a.is-primary,
  .sw-home-cta > a {
    border-color: var(--sw-accent, #34d399);
    background: var(--sw-accent, #34d399);
    color: #052016;
  }

  .sw-home-proof {
    display: flex;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sw-border, #202b40);
  }

  .sw-home-proof div {
    display: grid;
    gap: 0.2rem;
  }

  .sw-home-proof dt {
    color: var(--sw-fg-strong, #f8fafc);
    font: 650 1.2rem var(--sw-font-display, system-ui);
  }

  .sw-home-proof dd {
    margin: 0;
    color: var(--sw-fg-dim, #64748b);
    font: 500 var(--sw-type-xs) var(--sw-font-mono, monospace);
    text-transform: uppercase;
  }

  .sw-home-hero__demo {
    min-width: 0;
  }

  .sw-home-principles,
  .sw-home-integrations {
    padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 6vw, 6rem);
    border-bottom: 1px solid var(--sw-border, #202b40);
  }

  .sw-home-principles > header,
  .sw-home-integrations > header {
    max-width: 58rem;
    margin-bottom: 2.5rem;
  }

  .sw-home h2 {
    margin-block: 0.6rem 0;
    color: var(--sw-fg-strong, #f8fafc);
    font: 650 clamp(1.8rem, 3vw, 3.25rem) / 1.05 var(--sw-font-display, system-ui);
    letter-spacing: -0.04em;
  }

  .sw-home-principles__grid,
  .sw-home-integrations__grid {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--sw-border, #202b40);
    border-radius: 1rem;
    background: var(--sw-border, #202b40);
  }

  .sw-home-principles__grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .sw-home-principles article,
  .sw-home-integrations__grid a {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--sw-surface-1, #0b1120);
  }

  .sw-home-principles article > span,
  .sw-home-integrations__grid a > span {
    color: var(--sw-accent, #34d399);
    font: 600 var(--sw-type-xs) var(--sw-font-mono, monospace);
    letter-spacing: 0.12em;
  }

  .sw-home h3 {
    margin-block: 2rem 0.65rem;
    color: var(--sw-fg-strong, #f8fafc);
    font: 620 1.25rem var(--sw-font-display, system-ui);
  }

  .sw-home-principles p,
  .sw-home-integrations p {
    color: var(--sw-fg-muted, #91a4c1);
    line-height: 1.65;
  }

  .sw-home-integrations > header > p {
    margin-top: 1rem;
  }

  .sw-home-integrations__grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .sw-home-integrations__grid a {
    display: grid;
    min-height: 15rem;
    grid-template-rows: auto 1fr auto;
    color: inherit;
    text-decoration: none;
    transition: background 150ms ease;
  }

  .sw-home-integrations__grid a:hover {
    background: color-mix(in srgb, var(--integration-accent) 8%, var(--sw-surface-1, #0b1120));
  }

  .sw-home-integrations__grid a > span,
  .sw-home-integrations__grid a > strong {
    color: var(--integration-accent);
  }

  .sw-home-integrations__grid a > strong {
    font-size: var(--sw-type-xs);
  }

  .sw-home-cta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 6vw, 6rem);
  }

  .sw-home-footer {
    display: flex;
    min-height: 5rem;
    align-items: center;
    gap: 1.5rem;
    padding-inline: clamp(1.25rem, 5vw, 5rem);
    border-top: 1px solid var(--sw-border, #202b40);
    color: var(--sw-fg-dim, #64748b);
    font-size: var(--sw-type-xs);
  }

  .sw-home-footer > span:first-child {
    color: var(--sw-fg-strong, #f8fafc);
    font-weight: 650;
  }

  .sw-home-footer nav {
    display: flex;
    gap: 1rem;
    margin-inline-start: auto;
  }

  .sw-home-footer a {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 70rem) {
    .sw-home-hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .sw-home-hero__copy {
      max-width: 54rem;
    }

    .sw-home h1 {
      max-width: 48rem;
    }

    .sw-home-principles__grid,
    .sw-home-integrations__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 42rem) {
    .sw-home-hero {
      padding-block: 3.5rem 1rem;
    }

    .sw-home h1 {
      font-size: clamp(2.5rem, 10vw, 3.4rem);
    }

    .sw-home-principles__grid,
    .sw-home-integrations__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .sw-home-cta,
    .sw-home-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .sw-home-footer {
      padding-block: 1.25rem;
    }

    .sw-home-footer nav {
      margin-inline-start: 0;
    }
  }
</style>

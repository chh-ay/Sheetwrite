---
import {
  Braces,
  Calculator,
  Database,
  Download,
  Layers3,
  Monitor,
  RefreshCw,
  Search,
  Table2,
  Workflow,
} from "lucide-astro";
import Layout from "@/layouts/Layout.astro";
import { withBasePath } from "../base-path.js";
import InstallCommand from "./InstallCommand.astro";

const proofIcons = {
  braces: Braces,
  calculator: Calculator,
  database: Database,
  download: Download,
  layers: Layers3,
  monitor: Monitor,
  refresh: RefreshCw,
  search: Search,
  table: Table2,
  workflow: Workflow,
} as const;

interface ProofItem {
  icon: keyof typeof proofIcons;
  title: string;
  detail: string;
}

interface Props {
  active: "vanilla" | "react" | "vue" | "svelte";
  eyebrow: string;
  title: string;
  description: string;
  packageName: string;
  guide: string;
  sourcePath: string;
  proof: readonly ProofItem[];
}

const { active, eyebrow, title, description, packageName, guide, sourcePath, proof } = Astro.props;
const route = (path: string) => withBasePath(path, import.meta.env.BASE_URL);
---

<Layout title={`${title} · Sheetwrite`} description={description} active={active}>
  <main class="sw-showcase-page" data-framework={active}>
    <header class="sw-showcase-page__hero">
      <div>
        <p class="sw-showcase-page__eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      <InstallCommand packageName={packageName} />
    </header>

    <section class="sw-showcase-page__stage" aria-label={`${title} live example`}>
      <slot />
    </section>

    <section class="sw-showcase-page__proof" aria-labelledby="proof-title">
      <header>
        <h2 id="proof-title">Runtime details</h2>
        <p>Each interaction above runs through the public adapter and Grid APIs.</p>
      </header>
      <ul>
        {
          proof.map((item) => {
            const Icon = proofIcons[item.icon];
            return (
              <li>
                <Icon aria-hidden="true" size={22} strokeWidth={1.7} />
                <div>
                  <strong>{item.title}</strong>
                  <span>{item.detail}</span>
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>

    <footer class="sw-showcase-page__footer">
      <div>
        <strong>Build the integration</strong>
        <span>Lifecycle, SSR, reset, and event contracts are documented for this adapter.</span>
      </div>
      <nav aria-label="Example resources">
        <a href={route(guide)}>Read the guide</a>
        <a href={`https://github.com/chh-ay/Sheetwrite/blob/develop/${sourcePath}`}>View source</a>
      </nav>
    </footer>
  </main>
</Layout>

<style>
  .sw-showcase-page {
    min-height: calc(100vh - 4.5rem);
    padding: clamp(2.5rem, 6vw, 6.5rem) clamp(1rem, 4vw, 4rem) 4rem;
    background:
      radial-gradient(circle at 78% 4%, color-mix(in srgb, var(--framework-accent) 10%, transparent), transparent 28rem),
      var(--color-ink-950);
    color: var(--color-ink-200);
  }

  .sw-showcase-page[data-framework="vanilla"] {
    --framework-accent: var(--color-fw-vanilla);
  }

  .sw-showcase-page[data-framework="react"] {
    --framework-accent: var(--color-fw-react);
  }

  .sw-showcase-page[data-framework="vue"] {
    --framework-accent: var(--color-fw-vue);
  }

  .sw-showcase-page[data-framework="svelte"] {
    --framework-accent: var(--color-fw-svelte);
  }

  .sw-showcase-page > * {
    width: min(92rem, 100%);
    margin-inline: auto;
  }

  .sw-showcase-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .sw-showcase-page__eyebrow {
    margin: 0 0 0.9rem;
    color: var(--framework-accent);
    font: 600 var(--sw-type-xs) var(--font-mono);
    letter-spacing: 0.16em;
  }

  .sw-showcase-page h1 {
    max-width: 18ch;
    margin: 0;
    color: var(--color-ink-100);
    font: 650 clamp(2.6rem, 5vw, 5rem) / 0.96 var(--font-display);
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .sw-showcase-page__hero > div:first-child > p:last-child {
    max-width: 44rem;
    margin: 1.35rem 0 0;
    color: var(--color-ink-400);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
    text-wrap: pretty;
  }


  .sw-showcase-page__stage {
    overflow: hidden;
    min-height: 38rem;
    border: 1px solid var(--color-ink-700);
    border-radius: 1rem;
    background: var(--color-ink-900);
    box-shadow: 0 2.5rem 7rem rgb(0 0 0 / 35%);
  }

  .sw-showcase-page__proof {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .sw-showcase-page__proof > header {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(20rem, 1.3fr);
    gap: 2rem;
    align-items: end;
    padding-bottom: 1.5rem;
  }

  .sw-showcase-page__proof h2 {
    margin: 0;
    color: var(--color-ink-100);
    font: 620 clamp(1.8rem, 2.5vw, 2.4rem) / 1.08 var(--font-display);
    letter-spacing: -0.035em;
  }

  .sw-showcase-page__proof header p {
    max-width: 38rem;
    margin: 0;
    color: var(--color-ink-400);
    font-size: var(--sw-type-base);
    line-height: 1.6;
  }

  .sw-showcase-page__proof ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--color-ink-800);
    list-style: none;
  }

  .sw-showcase-page__proof li {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1.5rem;
    border-inline-start: 1px solid var(--color-ink-800);
  }

  .sw-showcase-page__proof li:first-child {
    border-inline-start: 0;
  }

  .sw-showcase-page__proof li > svg {
    color: var(--framework-accent);
  }

  .sw-showcase-page__proof li > div {
    display: grid;
    gap: 0.35rem;
  }

  .sw-showcase-page__proof li strong {
    color: var(--color-ink-100);
    font-size: var(--sw-type-base);
  }

  .sw-showcase-page__proof li span {
    color: var(--color-ink-400);
    font-size: var(--sw-type-sm);
    line-height: 1.55;
  }

  .sw-showcase-page__footer {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--color-ink-800);
  }

  .sw-showcase-page__footer div {
    display: grid;
    gap: 0.35rem;
  }

  .sw-showcase-page__footer strong {
    color: var(--color-ink-100);
    font-size: var(--sw-type-sm);
  }

  .sw-showcase-page__footer span {
    color: var(--color-ink-500);
    font-size: var(--sw-type-sm);
  }

  .sw-showcase-page__footer nav {
    display: flex;
    gap: 0.6rem;
  }

  .sw-showcase-page__footer a {
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-ink-700);
    border-radius: 0.45rem;
    color: var(--color-ink-300);
    font-size: var(--sw-type-sm);
    font-weight: 650;
    text-decoration: none;
  }

  .sw-showcase-page__footer a:first-child {
    border-color: var(--framework-accent);
    background: var(--framework-accent);
    color: var(--color-ink-950);
  }

  @media (max-width: 64rem) {
    .sw-showcase-page__hero,
    .sw-showcase-page__proof > header {
      grid-template-columns: minmax(0, 1fr);
    }

    .sw-showcase-page__proof ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sw-showcase-page__proof li:nth-child(odd) {
      border-inline-start: 0;
    }

    .sw-showcase-page__proof li:nth-child(n + 3) {
      border-block-start: 1px solid var(--color-ink-800);
    }
  }

  @media (max-width: 38rem) {
    .sw-showcase-page {
      padding-inline: 0.75rem;
    }

    .sw-showcase-page__proof ul {
      grid-template-columns: minmax(0, 1fr);
    }

    .sw-showcase-page__proof li {
      border-inline-start: 0;
      border-block-start: 1px solid var(--color-ink-800);
    }

    .sw-showcase-page__proof li:first-child {
      border-block-start: 0;
    }

    .sw-showcase-page__footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .sw-showcase-page__footer nav {
      width: 100%;
    }

    .sw-showcase-page__footer a {
      flex: 1;
      text-align: center;
    }
  }
</style>

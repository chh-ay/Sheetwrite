---
import { withBasePath } from "../base-path.js";

interface Props {
  active: string;
}

const { active } = Astro.props;
const route = (path: string) => withBasePath(path, import.meta.env.BASE_URL);

const links = [
  { slug: "docs", name: "Docs", href: "/docs/start/installation/" },
  { slug: "vanilla", name: "Core demo", href: "/vanilla/" },
  { slug: "react", name: "React", href: "/react/" },
  { slug: "vue", name: "Vue", href: "/vue/" },
  { slug: "svelte", name: "Svelte", href: "/svelte/" },
] as const;
---

<nav class="sw-nav flex h-16 flex-none items-stretch border-b border-ink-800 bg-ink-950 px-5 sm:px-7" aria-label="Sheetwrite examples">
  <a class="sw-brand inline-flex items-center gap-3 font-display text-sm font-semibold text-ink-50 no-underline" href={route("/")} aria-label="Sheetwrite home">
    <svg class="h-6 w-6 fill-ink-900 stroke-ink-500" viewBox="0 0 28 28" aria-hidden="true">
      <rect x="1" y="1" width="26" height="26"></rect>
      <path d="M1 10h26M1 18h26M10 1v26M18 1v26"></path>
      <rect class="fill-brand-500 stroke-brand-300" x="10" y="10" width="8" height="8"></rect>
    </svg>
    <span>Sheetwrite</span>
  </a>

  <div class="sw-links ml-auto flex min-w-0 items-stretch overflow-x-auto">
    {
      links.map((link) => (
        <a
          class="sw-tab relative inline-flex min-w-max items-center px-3 text-xs font-medium text-ink-400 no-underline transition hover:text-ink-100 sm:px-4"
          href={route(link.href)}
          aria-current={link.slug === active ? "page" : "false"}
        >
          {link.name}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .sw-tab[aria-current="page"] {
    color: var(--color-ink-50);
  }

  .sw-tab[aria-current="page"]::after {
    position: absolute;
    right: 0.75rem;
    bottom: -1px;
    left: 0.75rem;
    height: 2px;
    background: var(--color-brand-500);
    content: "";
  }

  @media (max-width: 34rem) {
    .sw-brand span {
      display: none;
    }
  }
</style>

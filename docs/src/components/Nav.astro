---
// Shared example switcher. Deliberately restrained: one rail, no status pills,
// fake formula controls, or dashboard decoration competing with the demos.
// Test contract: `.sw-nav`, stable demo hrefs, and bare framework names in links.
import { withBasePath } from "../base-path.js";

interface Props {
  active: string;
}

const { active } = Astro.props;
const route = (path: string) => withBasePath(path, import.meta.env.BASE_URL);

const links = [
  { slug: "docs", name: "Docs", accent: "var(--color-brand-500)" },
  { slug: "vanilla", name: "Vanilla", accent: "var(--color-fw-vanilla)" },
  { slug: "theming", name: "Theming", accent: "var(--color-fw-lab)" },
  { slug: "react", name: "React", accent: "var(--color-fw-react)" },
  { slug: "vue", name: "Vue", accent: "var(--color-fw-vue)" },
  { slug: "svelte", name: "Svelte", accent: "var(--color-fw-svelte)" },
];
---

<nav class="sw-nav" aria-label="Sheetwrite examples">
  <a class="sw-brand" href={route("/")} aria-label="Sheetwrite home">
    <svg class="sw-mark" viewBox="0 0 28 28" aria-hidden="true">
      <rect x="1" y="1" width="26" height="26"></rect>
      <path d="M1 10h26M1 18h26M10 1v26M18 1v26"></path>
      <rect class="sw-active-cell" x="10" y="10" width="8" height="8"></rect>
    </svg>
    <span>Sheetwrite</span>
  </a>
  <span class="sw-rule" aria-hidden="true"></span>
  <div class="sw-links">
    {
      links.map((link) => (
        <a
          class="sw-tab"
          href={route(`/${link.slug}/`)}
          aria-current={link.slug === active ? "page" : "false"}
          style={`--accent: ${link.accent}`}
        >
          {link.name}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .sw-nav {
    position: relative;
    z-index: 20;
    display: flex;
    flex: none;
    align-items: stretch;
    height: 54px;
    padding: 0 18px;
    border-bottom: 1px solid #20283a;
    background: #080b12;
    color: var(--color-ink-200);
  }

  .sw-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #f4f6fa;
    font: 650 14px var(--font-display);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .sw-mark {
    width: 25px;
    height: 25px;
    fill: #0f1520;
    stroke: #526078;
    stroke-width: 1;
  }

  .sw-mark .sw-active-cell {
    fill: var(--color-brand-500);
    stroke: var(--color-brand-300);
  }

  .sw-rule {
    width: 1px;
    margin: 15px 17px;
    background: #293247;
  }

  .sw-links {
    display: flex;
    align-items: stretch;
  }

  .sw-tab {
    position: relative;
    display: grid;
    min-width: 82px;
    place-items: center;
    padding: 0 14px;
    color: #758198;
    font: 520 12.5px var(--font-sans);
    text-decoration: none;
    transition:
      color 120ms,
      background 120ms;
  }

  .sw-tab::after {
    position: absolute;
    right: 14px;
    bottom: -1px;
    left: 14px;
    height: 2px;
    background: var(--accent);
    content: "";
    opacity: 0;
  }

  .sw-tab:hover {
    background: #0d131e;
    color: #dce2ec;
  }

  .sw-tab[aria-current="page"] {
    background: #101722;
    color: #f4f6fa;
  }

  .sw-tab[aria-current="page"]::after {
    opacity: 1;
  }


  @media (max-width: 780px) {
    .sw-nav {
      height: auto;
      min-height: 52px;
      padding-right: 0;
    }
    .sw-rule {
      display: none;
    }
    .sw-brand {
      padding-right: 14px;
    }
    .sw-links {
      flex: 1;
      overflow-x: auto;
    }
    .sw-tab {
      min-width: 70px;
      padding: 0 10px;
    }
  }

  @media (max-width: 510px) {
    .sw-brand span {
      display: none;
    }
  }
</style>

---
// Shared shell for every example page: fonts, tokens, favicon, nav.
import Nav from "@/components/Nav.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  active?: string;
}

const { title, description, active = "" } = Astro.props;
const isTestPage = Astro.url.pathname.startsWith("/test/");

// The logo mark, inlined as the favicon so the tab matches the nav.
const faviconSvg =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#0a101e"/><path d="M6 11h20M6 16h20M6 21h20M12 6v20M19 6v20" stroke="#10b981" stroke-width="1.6" stroke-linecap="round"/><rect x="12" y="11" width="7" height="5" fill="#10b981"/></svg>';
const favicon = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#05070d" />
    {description && <meta name="description" content={description} />}
    {isTestPage && <meta name="robots" content="noindex,nofollow,noarchive" />}
    <link rel="icon" href={favicon} />
    <title>{title}</title>
  </head>
  <body class="flex h-full flex-col overflow-hidden" data-pagefind-ignore={isTestPage || undefined}>
    <Nav active={active} />
    <slot />
  </body>
</html>

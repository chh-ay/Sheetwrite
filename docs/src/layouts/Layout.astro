---
import Nav from "@/components/Nav.astro";
import "@/styles/global.css";
import { withBasePath } from "../base-path.js";

interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = "Sheetwrite spreadsheet infrastructure for the web.",
  active = "",
} = Astro.props;
const isTestPage = Astro.url.pathname.startsWith(withBasePath("/test/", import.meta.env.BASE_URL));
const favicon = withBasePath("/favicon.svg", import.meta.env.BASE_URL);
const canonical = new URL(Astro.url.pathname, "https://chh-ay.github.io").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070a12" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {isTestPage && <meta name="robots" content="noindex,nofollow,noarchive" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />
    <title>{title}</title>
  </head>
  <body data-pagefind-ignore={isTestPage || undefined}>
    <Nav active={active} />
    <slot />
  </body>
</html>

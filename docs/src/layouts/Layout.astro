---
// Shared shell for every example page: fonts, tokens, favicon, nav.
import Nav from "@/components/Nav.astro";
import "@/styles/global.css";
import { withBasePath } from "../base-path.js";

interface Props {
  title: string;
  description?: string;
  active?: string;
}

const { title, description, active = "" } = Astro.props;
const isTestPage = Astro.url.pathname.startsWith(withBasePath("/test/", import.meta.env.BASE_URL));

const favicon = withBasePath("/favicon.svg", import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#05070d" />
    {description && <meta name="description" content={description} />}
    {isTestPage && <meta name="robots" content="noindex,nofollow,noarchive" />}
    <link rel="icon" href={favicon} />
    <title>{title}</title>
  </head>
  <body class="flex h-full flex-col overflow-hidden" data-pagefind-ignore={isTestPage || undefined}>
    <Nav active={active} />
    <slot />
  </body>
</html>

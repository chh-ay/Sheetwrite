---
import ShowcasePage from "@/components/ShowcasePage.astro";
import SvelteWorkbook from "@/components/SvelteWorkbook.svelte";
---

<ShowcasePage
  active="svelte"
  eyebrow="SVELTE / FORMULA MODEL"
  title="Compose a workbook from live components, not DOM cells."
  description="A focused Svelte workflow that edits assumptions, evaluates formulas, manages sheets and merges, and observes committed transactions while Sheetwrite keeps the hot path on Canvas and WASM."
  packageName="@sheetwrite/svelte"
  guide="/docs/frameworks/svelte/"
  sourcePath="docs/src/components/SvelteWorkbook.svelte"
  proof={[
    { icon: "calculator", title: "Formula graph", detail: "Dependencies recalculate inside the workbook engine." },
    { icon: "table", title: "Workbook operations", detail: "Selection, edits, merges, and sheets use the Grid API." },
    { icon: "workflow", title: "Svelte events", detail: "Committed transactions arrive through adapter callbacks." },
    { icon: "layers", title: "Canvas surface", detail: "The hot path stays off the component and DOM trees." },
  ]}
>
  <SvelteWorkbook client:only="svelte" />
</ShowcasePage>

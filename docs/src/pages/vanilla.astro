---
import {
  AlignCenter,
  AlignLeft,
  AlignRight,
  ArrowDownAZ,
  Bold,
  Download,
  Grid2X2,
  Italic,
  Merge,
  PaintBucket,
  Redo2,
  Table2,
  Type,
  Undo2,
  Upload,
} from "lucide-astro";
// Complete workbook shell over the headless imperative API.
// Wiring contract with src/lib/vanilla.ts: every #t-* button id, #namebox,
// #formula, #status, #csvfile, #app, and the .gs-zoom class must survive.
import ShowcasePage from "@/components/ShowcasePage.astro";
---

<ShowcasePage
  active="vanilla"
  eyebrow="VANILLA / IMPERATIVE WORKBOOK"
  title="Own every piece of workbook chrome."
  description="A production-shaped spreadsheet shell built directly on Sheetwrite's headless API: toolbar actions, formula editing, workbook tabs, cross-sheet formulas, and CSV exchange."
  packageName="@sheetwrite/core"
  guide="/docs/frameworks/vanilla/"
  sourcePath="docs/src/lib/vanilla.ts"
  proof={[
    { icon: "braces", title: "Imperative chrome", detail: "Toolbar, formula bar, and status share one Grid instance." },
    { icon: "database", title: "Columnar store", detail: "100,000 eager rows stay in the WASM-backed engine." },
    { icon: "table", title: "Workbook model", detail: "Tabs and cross-sheet formulas remain live together." },
    { icon: "download", title: "CSV exchange", detail: "Import and export run through the public Grid API." },
  ]}
>
  <div class="sw-vanilla-demo">
  <!-- Title + menu -->
  <div class="gs-title">
    <div class="gs-logo" aria-hidden="true">
      <Table2 size={20} strokeWidth={1.8} />
    </div>
    <div class="gs-titlewrap">
      <div class="gs-overline">Vanilla API</div>
      <div class="gs-docname">Sales workbook</div>
      <nav class="gs-menu">
        <span>File</span><span>Edit</span><span>View</span><span>Insert</span>
        <span>Format</span><span>Data</span><span>Tools</span><span>Help</span>
      </nav>
    </div>
    <span class="gs-rowcount">100,000 rows</span>
  </div>

  <!-- Toolbar -->
  <div class="gs-toolbar">
    <button id="t-undo" type="button" title="Undo (Ctrl+Z)">
      <Undo2 aria-hidden="true" size={17} />
    </button>
    <button id="t-redo" type="button" title="Redo (Ctrl+Shift+Z)">
      <Redo2 aria-hidden="true" size={17} />
    </button>
    <span class="gs-div"></span>
    <button class="gs-zoom" type="button" title="Zoom">100%</button>
    <span class="gs-div"></span>
    <button id="t-bold" class="b" type="button" title="Bold (Ctrl+B)"><Bold aria-hidden="true" size={16} /></button>
    <button id="t-italic" class="i" type="button" title="Italic (Ctrl+I)"><Italic aria-hidden="true" size={16} /></button>
    <span class="gs-color" title="Text color">
      <span class="glyph"><Type aria-hidden="true" size={16} /></span>
      <span class="bar" id="t-textcolor-bar" style="background:#34d399"></span>
      <input id="t-textcolor" type="color" value="#34d399" aria-label="Text color" />
    </span>
    <span class="gs-color" title="Fill color">
      <PaintBucket aria-hidden="true" size={16} />
      <span class="bar" id="t-fillcolor-bar" style="background:#fff7e0"></span>
      <input id="t-fillcolor" type="color" value="#fff7e0" aria-label="Fill color" />
    </span>
    <span class="gs-div"></span>
    <button id="t-border" type="button" title="Borders">
      <Grid2X2 aria-hidden="true" size={16} />
    </button>
    <button id="t-merge" type="button" title="Merge cells">
      <Merge aria-hidden="true" size={16} />
    </button>
    <span class="gs-div"></span>
    <button id="t-alignl" type="button" title="Align left">
      <AlignLeft aria-hidden="true" size={16} />
    </button>
    <button id="t-alignc" type="button" title="Align center">
      <AlignCenter aria-hidden="true" size={16} />
    </button>
    <button id="t-alignr" type="button" title="Align right">
      <AlignRight aria-hidden="true" size={16} />
    </button>
    <span class="gs-div"></span>
    <button id="t-sort" type="button" title="Sort sheet by column (A→Z)">
      <ArrowDownAZ aria-hidden="true" size={16} />
    </button>
    <button id="t-export" type="button" title="Download as CSV">
      <Download aria-hidden="true" size={16} />
    </button>
    <button id="t-import" type="button" title="Import CSV">
      <Upload aria-hidden="true" size={16} />
    </button>
    <input id="csvfile" type="file" accept=".csv" hidden />
  </div>

  <!-- Formula bar -->
  <div class="gs-formula">
    <input
      id="namebox"
      class="gs-namebox"
      value="A1"
      aria-label="Name box"
      title="Name box — type a cell (e.g. C12) and press Enter"
    />
    <span class="gs-fx">fx</span>
    <input id="formula" class="gs-input" aria-label="Formula bar" placeholder="" />
  </div>

  <!-- Grid -->
  <div id="app"></div>

  <!-- Bottom bar: selection stats (sheet tabs live inside the grid). -->
  <div class="gs-bottom">
    <span class="gs-hint">Try the Summary tab — it holds live cross-sheet formulas into Sales</span>
    <div class="gs-status" id="status"></div>
  </div>
  </div>

  <script>
    import "../lib/vanilla";
  </script>

  <style is:global>
    .sw-vanilla-demo {
      display: flex;
      height: 46rem;
      min-height: 38rem;
      flex-direction: column;
      background: #080b12;
      color: #d8deea;
    }

    /* ── Workbook masthead ─────────────────────────────────────── */
    .gs-title {
      position: relative;
      display: flex;
      align-items: center;
      gap: 14px;
      flex: none;
      min-height: 64px;
      padding: 9px 16px;
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--color-fw-vanilla) 7%, transparent), transparent 35%),
        #080b12;
      border-bottom: 1px solid #20283a;
    }
    .gs-title::after {
      position: absolute;
      right: 0;
      bottom: -1px;
      left: 0;
      height: 1px;
      background: linear-gradient(90deg, var(--color-fw-vanilla), transparent 28%);
      content: "";
    }
    .gs-logo {
      width: 38px;
      height: 38px;
      display: grid;
      flex: none;
      place-items: center;
      color: #090b10;
      background: var(--color-fw-vanilla);
      border: 1px solid #ffd667;
      border-radius: 3px;
      box-shadow: 4px 4px 0 #362d15;
    }
    .gs-titlewrap {
      display: flex;
      min-width: 0;
      flex: 1;
      flex-direction: column;
      line-height: 1.25;
    }
    .gs-overline {
      margin-bottom: 1px;
      color: #877c61;
      font: 10.5px var(--font-mono);
      letter-spacing: 0.14em;
    }
    .gs-docname {
      color: #f4f1e9;
      font: 650 16px var(--font-display);
      letter-spacing: -0.01em;
    }
    .gs-menu {
      display: flex;
      gap: 1px;
      margin-top: 2px;
      color: #6f788b;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .gs-menu span {
      padding: 1px 6px;
      border-radius: 2px;
      cursor: default;
    }
    .gs-menu span:hover {
      background: #171d29;
      color: var(--color-fw-vanilla);
    }
    .gs-rowcount {
      padding-left: 14px;
      border-left: 1px solid #2a3140;
      color: #9f9579;
      font: 11px var(--font-mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* ── Headless API toolbar ──────────────────────────────────── */
    .gs-toolbar {
      display: flex;
      align-items: center;
      gap: 2px;
      flex: none;
      min-height: 38px;
      margin: 0;
      padding: 4px 12px;
      background: #0e131d;
      border-bottom: 1px solid #252d3d;
      box-shadow: inset 0 1px 0 #171e2b;
    }
    .gs-toolbar button {
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      border: 1px solid transparent;
      border-radius: 3px;
      background: transparent;
      color: #9ca7b9;
      cursor: pointer;
      font: 500 14px var(--font-sans);
      padding: 0;
      transition:
        border-color 100ms,
        background 100ms;
    }
    .gs-toolbar button:hover {
      border-color: #3b4559;
      background: #1a2230;
      color: var(--color-fw-vanilla);
    }
    .gs-toolbar button svg {
      width: 17px;
      height: 17px;
      fill: currentColor;
    }
    .gs-toolbar .b {
      font-weight: 700;
    }
    .gs-toolbar .i {
      font-style: italic;
      font-family: Georgia, serif;
    }
    .gs-div {
      width: 1px;
      height: 19px;
      margin: 0 6px;
      background: #30394a;
    }
    .gs-toolbar button.gs-zoom {
      width: auto;
      padding: 0 10px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--color-fw-vanilla);
    }
    .gs-color {
      position: relative;
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      border: 1px solid transparent;
      border-radius: 3px;
      cursor: pointer;
      color: #9ca7b9;
    }
    .gs-color:hover {
      border-color: #3b4559;
      background: #1a2230;
      color: var(--color-fw-vanilla);
    }
    .gs-toolbar .gs-color svg {
      width: 17px;
      height: 17px;
      fill: currentColor;
    }
    .gs-color input {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
    }
    .gs-color .glyph {
      font-weight: 700;
      font-size: 13px;
      line-height: 1;
    }
    .gs-color .bar {
      position: absolute;
      bottom: 4px;
      width: 15px;
      height: 3px;
      border-radius: 2px;
    }

    /* ── Formula bar ───────────────────────────────────────────── */
    .gs-formula {
      display: flex;
      align-items: center;
      flex: none;
      height: 35px;
      border-bottom: 1px solid #242c3a;
      background: #090d14;
    }
    .gs-namebox {
      width: 96px;
      height: 100%;
      border: none;
      border-right: 1px solid #242c3a;
      background: #0d121c;
      text-align: center;
      font: 600 12px var(--font-mono);
      color: var(--color-fw-vanilla);
      outline: none;
    }
    .gs-namebox:focus {
      background: #171e2b;
      box-shadow: inset 0 -2px 0 var(--color-fw-vanilla);
    }
    .gs-fx {
      padding: 0 14px 0 12px;
      color: #5f6b80;
      font: italic 600 13px Georgia, serif;
    }
    .gs-input {
      flex: 1;
      height: 100%;
      border: none;
      outline: none;
      background: transparent;
      font: 12.5px var(--font-mono);
      color: #d8deea;
    }

    /* ── Grid ──────────────────────────────────────────────────── */
    #app {
      flex: 1;
      min-height: 0;
      background: #0a0d14;
    }

    /* ── Telemetry footer ──────────────────────────────────────── */
    .gs-bottom {
      display: flex;
      align-items: center;
      flex: none;
      height: 31px;
      padding: 0 14px;
      background: #080b11;
      border-top: 1px solid #20283a;
      color: #626d80;
      font: 11px var(--font-mono);
      letter-spacing: 0.02em;
    }
    .gs-hint {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .gs-hint::before {
      margin-right: 8px;
      color: var(--color-fw-vanilla);
      content: "→";
    }
    .gs-status {
      margin-left: auto;
      display: flex;
      gap: 18px;
      padding-left: 16px;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .gs-status b {
      color: var(--color-fw-vanilla);
      font-weight: 600;
    }

    /* ── In-grid widgets: the core shell joins the operator console ── */
    #app .sheetwrite-tabbar {
      border-color: #242c3a;
      background: #0e131d;
      color: #8994a8;
      font: 12.5px var(--font-sans);
    }
    #app .sheetwrite-tab-active {
      background: color-mix(in srgb, var(--color-fw-vanilla) 11%, #0e131d);
      color: var(--color-fw-vanilla);
      box-shadow: inset 0 -2px 0 var(--color-fw-vanilla);
    }
    #app .sheetwrite-tab:hover:not(.sheetwrite-tab-active) {
      background: #171e2b;
    }
    #app .sheetwrite-find,
    #app .sheetwrite-context-menu {
      border-color: #30394a;
      border-radius: 3px;
      background: #111722;
      color: #d8deea;
      font: 12.5px var(--font-sans);
      box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.28);
    }
    #app .sheetwrite-find-btn {
      color: var(--color-fw-vanilla);
    }
    #app .sheetwrite-context-menu-item:hover {
      background: color-mix(in srgb, var(--color-fw-vanilla) 12%, #111722);
    }

    @media (max-width: 760px) {
      .gs-rowcount {
        display: none;
      }
      .gs-menu span:nth-child(n + 5),
      .gs-hint {
        display: none;
      }
      .gs-toolbar {
        overflow-x: auto;
      }
    }
  </style>
</ShowcasePage>

---
import Layout from "@/layouts/Layout.astro";
import { withBasePath } from "../base-path.js";

const route = (path: string) => withBasePath(path, import.meta.env.BASE_URL);

const integrations = [
  {
    slug: "vanilla",
    label: "Core",
    title: "Imperative workbook",
    description: "Own the DOM lifecycle directly and compose the built-in spreadsheet shell.",
    accent: "var(--color-fw-vanilla)",
  },
  {
    slug: "react",
    label: "React",
    title: "100k-row analytics",
    description: "Render, search, filter, aggregate, and export through the React adapter.",
    accent: "var(--color-fw-react)",
  },
  {
    slug: "vue",
    label: "Vue",
    title: "Streaming datasource",
    description: "Page through one million virtual rows with delayed mutation acknowledgements.",
    accent: "var(--color-fw-vue)",
  },
  {
    slug: "svelte",
    label: "Svelte",
    title: "Formula workbook",
    description: "Compose the shared shell around live formulas and cross-sheet aggregates.",
    accent: "var(--color-fw-svelte)",
  },
] as const;
---

<Layout
  title="Sheetwrite — spreadsheet infrastructure for the web"
  description="A canvas spreadsheet backed by a Rust and WebAssembly columnar engine, with an imperative core and React, Vue, and Svelte adapters."
>
  <main class="min-h-0 flex-1 overflow-y-auto bg-ink-950">
    <section class="border-b border-ink-800">
      <div class="mx-auto grid max-w-7xl gap-16 px-6 py-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(25rem,.95fr)] lg:items-center lg:py-28">
        <div class="max-w-3xl">
          <p class="mb-6 font-mono text-[11px] font-semibold tracking-[0.16em] text-brand-300 uppercase">
            Open source · Rust + WebAssembly · Canvas
          </p>
          <h1 class="m-0 max-w-3xl font-display text-5xl leading-[1.02] font-semibold tracking-[-0.055em] text-ink-50 sm:text-6xl lg:text-7xl">
            Spreadsheet infrastructure for the web.
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-ink-300">
            Sheetwrite provides the engine, rendering, formulas, and framework adapters for products that need a real spreadsheet—not another table component.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href={route("/docs/start/installation/")}
              class="inline-flex min-h-11 items-center rounded-md bg-brand-500 px-5 text-sm font-semibold text-ink-950 no-underline transition hover:bg-brand-300"
            >
              Read the documentation
            </a>
            <a
              href={route("/vanilla/")}
              class="inline-flex min-h-11 items-center rounded-md border border-ink-600 px-5 text-sm font-semibold text-ink-100 no-underline transition hover:border-ink-400 hover:bg-ink-900"
            >
              Open the workbook demo
            </a>
          </div>
          <div class="mt-5 inline-flex items-center gap-3 rounded-md border border-ink-800 bg-ink-900/70 px-4 py-2 font-mono text-xs text-ink-400">
            <span class="text-ink-600">$</span>
            <code>bun add <span class="text-brand-300">@sheetwrite/react</span></code>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-ink-700 bg-ink-900 shadow-2xl shadow-black/25" aria-label="Sheetwrite workbook preview">
          <div class="flex items-center gap-3 border-b border-ink-700 px-4 py-3">
            <span class="grid h-7 w-7 place-items-center rounded bg-brand-500 font-mono text-xs font-semibold text-ink-950">S</span>
            <div>
              <p class="m-0 text-xs font-semibold text-ink-100">Revenue plan</p>
              <p class="m-0 mt-0.5 font-mono text-[9px] text-ink-500">Autosaved · Sheet 1</p>
            </div>
            <span class="ml-auto rounded-full border border-ink-700 px-2.5 py-1 font-mono text-[9px] text-ink-400">100k rows</span>
          </div>
          <div class="grid grid-cols-[3.25rem_2rem_minmax(0,1fr)] border-b border-ink-700 bg-ink-950/70 font-mono text-[10px]">
            <span class="border-r border-ink-700 px-3 py-2 text-brand-300">D6</span>
            <span class="border-r border-ink-700 px-2 py-2 text-ink-500">fx</span>
            <span class="truncate px-3 py-2 text-ink-300">=SUM(D2:D5)</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[32rem] table-fixed border-collapse text-left text-[11px] text-ink-300">
              <thead class="bg-ink-950/80 font-mono text-[9px] text-ink-500">
                <tr>
                  <th class="w-8 border-r border-b border-ink-800 px-2 py-2"></th>
                  <th class="border-r border-b border-ink-800 px-3 py-2 font-medium">A</th>
                  <th class="border-r border-b border-ink-800 px-3 py-2 font-medium">B</th>
                  <th class="border-r border-b border-ink-800 px-3 py-2 font-medium">C</th>
                  <th class="border-b border-ink-800 px-3 py-2 font-medium">D</th>
                </tr>
              </thead>
              <tbody>
                <tr class="font-semibold text-ink-100">
                  <th class="border-r border-b border-ink-800 px-2 py-2 text-center font-mono text-[9px] font-normal text-ink-600">1</th>
                  <td class="border-r border-b border-ink-800 px-3 py-2">Quarter</td>
                  <td class="border-r border-b border-ink-800 px-3 py-2">Region</td>
                  <td class="border-r border-b border-ink-800 px-3 py-2">Owner</td>
                  <td class="border-b border-ink-800 px-3 py-2">Revenue</td>
                </tr>
                <tr>
                  <th class="border-r border-b border-ink-800 px-2 py-2 text-center font-mono text-[9px] font-normal text-ink-600">2</th>
                  <td class="border-r border-b border-ink-800 px-3 py-2">Q1</td>
                  <td class="border-r border-b border-ink-800 px-3 py-2">North</td>
                  <td class="border-r border-b border-ink-800 px-3 py-2">Mira</td>
                  <td class="border-b border-ink-800 px-3 py-2 text-right font-mono">$84,320</td>
                </tr>
                <tr>
                  <th class="border-r border-b border-ink-800 px-2 py-2 text-center font-mono text-[9px] font-normal text-ink-600">3</th>
                  <td class="border-r border-b border-ink-800 px-3 py-2">Q2</td>
                  <td class="border-r border-b border-ink-800 px-3 py-2">West</td>
                  <td class="border-r border-b border-ink-800 px-3 py-2">Jon</td>
                  <td class="border-b border-ink-800 px-3 py-2 text-right font-mono">$97,680</td>
                </tr>
                <tr>
                  <th class="border-r border-b border-ink-800 px-2 py-2 text-center font-mono text-[9px] font-normal text-ink-600">4</th>
                  <td class="border-r border-b border-ink-800 px-3 py-2">Q3</td>
                  <td class="border-r border-b border-ink-800 px-3 py-2">East</td>
                  <td class="border-r border-b border-ink-800 px-3 py-2">Ari</td>
                  <td class="border-b border-ink-800 px-3 py-2 text-right font-mono">$112,940</td>
                </tr>
                <tr>
                  <th class="border-r border-b border-ink-800 px-2 py-2 text-center font-mono text-[9px] font-normal text-ink-600">5</th>
                  <td class="border-r border-b border-ink-800 px-3 py-2">Q4</td>
                  <td class="border-r border-b border-ink-800 px-3 py-2">South</td>
                  <td class="border-r border-b border-ink-800 px-3 py-2">Noa</td>
                  <td class="border-b border-ink-800 px-3 py-2 text-right font-mono">$126,500</td>
                </tr>
                <tr class="bg-brand-500/5">
                  <th class="border-r border-ink-800 px-2 py-2 text-center font-mono text-[9px] font-normal text-ink-600">6</th>
                  <td class="border-r border-ink-800 px-3 py-2 font-semibold text-ink-100" colspan="3">Annual total</td>
                  <td class="relative border-2 border-brand-500 px-3 py-2 text-right font-mono font-semibold text-brand-300">$421,440</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="flex items-center border-t border-ink-700 bg-ink-950/70 px-4">
            <span class="border-b-2 border-brand-500 px-3 py-2.5 text-[10px] font-semibold text-ink-100">Forecast</span>
            <span class="px-3 py-2.5 text-[10px] text-ink-500">Assumptions</span>
            <span class="ml-auto font-mono text-[9px] text-ink-600">Ready</span>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-ink-800 bg-ink-900/35">
      <div class="mx-auto grid max-w-7xl divide-y divide-ink-800 px-6 md:grid-cols-3 md:divide-x md:divide-y-0">
        <article class="py-10 md:pr-10">
          <p class="m-0 font-mono text-xs text-brand-300">01</p>
          <h2 class="mt-4 mb-0 font-display text-xl font-semibold text-ink-50">One canvas, stable DOM size</h2>
          <p class="mt-3 mb-0 leading-7 text-ink-300">Only the visible window is painted. A million rows do not become a million elements.</p>
        </article>
        <article class="py-10 md:px-10">
          <p class="m-0 font-mono text-xs text-brand-300">02</p>
          <h2 class="mt-4 mb-0 font-display text-xl font-semibold text-ink-50">Columnar work stays in Rust</h2>
          <p class="mt-3 mb-0 leading-7 text-ink-300">Sort, filter, search, formulas, and aggregates cross the WASM boundary as bulk operations.</p>
        </article>
        <article class="py-10 md:pl-10">
          <p class="m-0 font-mono text-xs text-brand-300">03</p>
          <h2 class="mt-4 mb-0 font-display text-xl font-semibold text-ink-50">One API across frameworks</h2>
          <p class="mt-3 mb-0 leading-7 text-ink-300">Use the imperative engine directly or mount thin React, Vue, and Svelte adapters.</p>
        </article>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-8 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-16">
        <div>
          <p class="m-0 font-mono text-[11px] font-semibold tracking-[0.14em] text-brand-300 uppercase">Working examples</p>
          <h2 class="mt-4 mb-0 font-display text-3xl font-semibold tracking-[-0.035em] text-ink-50">See each integration under load.</h2>
          <p class="mt-4 mb-0 leading-7 text-ink-300">Every example is a complete product surface with real editing, data, and lifecycle behavior.</p>
        </div>

        <div class="border-t border-ink-700">
          {
            integrations.map((integration) => (
              <a
                href={route(`/${integration.slug}/`)}
                class="group grid gap-3 border-b border-ink-800 py-6 text-inherit no-underline transition hover:border-ink-600 sm:grid-cols-[7rem_minmax(0,1fr)_auto] sm:items-center"
              >
                <span class="font-mono text-xs font-semibold" style={`color: ${integration.accent}`}>
                  {integration.label}
                </span>
                <span>
                  <strong class="block font-display text-lg font-semibold text-ink-50">{integration.title}</strong>
                  <span class="mt-1 block text-sm leading-6 text-ink-400">{integration.description}</span>
                </span>
                <span class="text-ink-500 transition group-hover:translate-x-1 group-hover:text-brand-300" aria-hidden="true">→</span>
              </a>
            ))
          }
          <a
            href={route("/theming/")}
            class="group grid gap-3 border-b border-ink-800 py-6 text-inherit no-underline transition hover:border-ink-600 sm:grid-cols-[7rem_minmax(0,1fr)_auto] sm:items-center"
          >
            <span class="font-mono text-xs font-semibold text-violet-300">Theming</span>
            <span>
              <strong class="block font-display text-lg font-semibold text-ink-50">Renderer laboratory</strong>
              <span class="mt-1 block text-sm leading-6 text-ink-400">Switch palettes, paint custom cells, and apply store-backed formatting.</span>
            </span>
            <span class="text-ink-500 transition group-hover:translate-x-1 group-hover:text-brand-300" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-ink-800 bg-ink-900/35">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-6 py-14 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="m-0 font-display text-2xl font-semibold text-ink-50">Ready to build?</h2>
          <p class="mt-2 mb-0 text-ink-400">Install the core, choose an adapter, and render your first grid.</p>
        </div>
        <a href={route("/docs/start/installation/")} class="text-sm font-semibold text-brand-300 no-underline hover:text-brand-200">Start with installation →</a>
      </div>
    </section>

    <footer class="border-t border-ink-800">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-6 py-7 text-xs text-ink-500">
        <p class="m-0">Sheetwrite · MIT licensed</p>
        <div class="flex gap-5">
          <a class="text-ink-400 no-underline hover:text-ink-100" href="https://github.com/chh-ay/Sheetwrite">GitHub</a>
          <a class="text-ink-400 no-underline hover:text-ink-100" href={route("/docs/reference/package-entry-points/")}>Packages</a>
          <a class="text-ink-400 no-underline hover:text-ink-100" href={route("/docs/api/")}>API</a>
        </div>
      </div>
    </footer>
  </main>
</Layout>

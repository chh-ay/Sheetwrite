---
import DemoHeader from "@/components/DemoHeader.astro";
import VueConsole from "@/components/VueConsole";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Sheetwrite — Vue streaming console"
  description="One million virtual rows behind a paged DataSource with simulated latency, stable mutation IDs, explicit retries, and server-version acknowledgements."
  active="vue"
>
  <DemoHeader
    accent="var(--color-fw-vue)"
    kicker="Vue adapter"
    title="Streaming data, visible rows only"
  >
    One million rows stay behind a paged <code>DataSource</code>; only the visible window and
    overscan are cached. Scroll to trigger delayed page requests, then use the numbered event
    steps to edit, search, and acknowledge changes.
  </DemoHeader>
  <div id="app">
    <VueConsole client:only="vue" />
  </div>

  <style is:global>
    #app {
      flex: 1;
      min-height: 0;
    }
    #app > astro-island,
    #app > astro-island > .example-shell,
    #app > .example-shell {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .example-body {
      flex: 1;
      min-height: 0;
      display: grid;
      grid-template-columns: 1fr 320px;
    }

    .example-grid {
      display: flex;
      flex-direction: column;
    }

    .stream-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 28px;
      padding: 0 10px;
      border-bottom: 1px solid var(--chrome-border);
      background: var(--chrome-raised);
      color: var(--chrome-muted);
      font: 10.5px var(--font-mono);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .stream-strip output {
      color: var(--chrome-accent);
      font: inherit;
      letter-spacing: 0;
    }

    .example-grid > .sheetwrite {
      flex: 1;
      min-height: 0;
    }

    /* Event pipeline side panel. */
    .example-log {
      display: flex;
      flex-direction: column;
      min-height: 0;
      border-left: 1px solid var(--chrome-border);
      padding: 12px 14px;
      overflow-y: auto;
      background: var(--chrome-raised);
      color: var(--chrome-fg);
      font: 12px/1.6 var(--font-mono);
    }
    .example-log h2 {
      margin: 0 0 4px;
      font: 600 13px var(--font-display);
      color: var(--chrome-fg);
    }
    .example-hint {
      margin: 0 0 8px;
      font: 12px/1.5 var(--font-sans);
      color: var(--chrome-muted);
    }
    .example-sync {
      display: block;
      margin: 10px 0 7px;
      padding: 6px 0;
      border-top: 1px solid var(--chrome-border);
      border-bottom: 1px solid var(--chrome-border);
      color: var(--chrome-accent);
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }

    .event-actions {
      display: grid;
      gap: 6px;
      margin-top: 5px;
    }

    .event-actions button,
    .example-log .acknowledge {
      display: grid;
      grid-template-columns: 18px 1fr;
      align-items: center;
      gap: 8px;
      min-height: 34px;
      padding: 5px 9px;
      border: 1px solid var(--chrome-border);
      border-radius: 2px;
      background: var(--chrome-bg);
      color: var(--chrome-fg);
      font: 12px var(--font-mono);
      text-align: left;
      cursor: pointer;
    }

    .event-actions button:hover,
    .example-log .acknowledge:hover:not(:disabled) {
      border-color: var(--chrome-accent);
    }

    .event-actions svg,
    .example-log .acknowledge svg {
      width: 16px;
      height: 16px;
      color: var(--chrome-accent);
    }

    .event-actions b,
    .example-log .acknowledge b {
      margin-right: 6px;
      color: var(--chrome-accent);
      font-weight: 600;
    }

    .example-log .acknowledge:disabled {
      opacity: 0.4;
      cursor: default;
    }
    .example-log ul {
      list-style: none;
      margin: 12px 0 0;
      padding: 0;
      white-space: nowrap;
    }
    .example-log li {
      padding: 2px 0;
      border-bottom: 1px dashed var(--chrome-border);
      color: var(--chrome-muted);
    }
    .example-log li:first-child {
      color: var(--chrome-accent);
    }

    @media (max-width: 860px) {
      .example-body {
        grid-template-columns: 1fr;
      }
      .example-log {
        display: none;
      }
    }
  </style>
</Layout>

---
// Style lab: runtime theme switching, a custom canvas badge renderer, and
// store-backed per-cell fills. Wiring contract with src/lib/theming.ts:
// #theme-light / #theme-dark / #theme-brand, #cell-fill, #stage, #app.
import Layout from "@/layouts/Layout.astro";

const themes = [
  { id: "theme-light", name: "Studio", chips: ["#f7f8fb", "#111827", "#10b981"], pressed: true },
  { id: "theme-dark", name: "Midnight", chips: ["#0b1020", "#12192a", "#38bdf8"], pressed: false },
  { id: "theme-brand", name: "Mulberry", chips: ["#fffafc", "#5b214e", "#d946ef"], pressed: false },
];
---

<Layout
  title="Sheetwrite — theming & custom renderers"
  description="Runtime theme switching, a custom canvas badge cell renderer, and per-cell fills applied through the store."
  active="theming"
>
  <main class="lab-console">
  <header class="lab-header">
    <span class="lab-index" aria-hidden="true">02 / STYLE SYSTEM</span>
    <div class="lab-lead">
      <p class="lab-kicker">Style lab</p>
      <h1 class="lab-title">Theming &amp; custom renderers</h1>
      <p class="lab-copy">
        The canvas repaints from a <code>Theme</code> object via <code>grid.setTheme()</code> — no
        CSS round-trip. The <em>Status</em> column is a custom
        <code>CellRenderer.canvas</code> tag, and the fill picker writes per-cell styles through
        <code>store.applyTransaction</code>.
      </p>
    </div>
    <div class="toolbar" role="group" aria-label="Theme controls">
      {
        themes.map((theme) => (
          <button
            type="button"
            id={theme.id}
            aria-label={theme.id === "theme-dark" ? "Dark theme — Midnight" : undefined}
            aria-pressed={theme.pressed ? "true" : "false"}
          >
            <span class="swatch" aria-hidden="true">
              {theme.chips.map((chip) => (
                <span style={`background:${chip}`} />
              ))}
            </span>
            {theme.name}
          </button>
        ))
      }
      <label class="fill-label">
        Cell fill
        <input type="color" id="cell-fill" value="#ddd6fe" />
      </label>
      <span class="lab-hint">Select a cell first — the fill is written through the store</span>
    </div>
  </header>
  <div class="lab-body">
    <div class="stage-head">
      <span>CANVAS PREVIEW</span>
      <span>updates immediately</span>
    </div>
    <div class="stage sheetwrite" id="stage">
      <div id="app"></div>
    </div>
    <aside class="lab-panel" aria-label="Active theme">
      <h2>Active theme</h2>
      <p>
        Everything the canvas paints comes from this object — pass it to
        <code>createGrid</code> or swap it live with <code>grid.setTheme()</code>.
      </p>
      <pre id="theme-json" aria-live="polite"></pre>
      <h2>Custom renderer</h2>
      <p>
        The <em>Status</em> tags are plain <code>CellRenderer.canvas</code> drawing calls with the
        cell rect, value, and active theme handed in.
      </p>
    </aside>
  </div>
  </main>

  <script>
    import "../lib/theming";
  </script>

  <style is:global>
    .lab-console {
      display: grid;
      grid-template-columns: 310px minmax(0, 1fr);
      flex: 1;
      min-height: 0;
      background: #070910;
    }

    .lab-header {
      position: relative;
      display: flex;
      min-height: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      padding: 22px 20px;
      overflow-y: auto;
      border-right: 1px solid #29233d;
      background:
        linear-gradient(rgba(167, 139, 250, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(167, 139, 250, 0.035) 1px, transparent 1px),
        #0c0a13;
      background-size: 22px 22px;
    }

    .lab-header::after {
      position: absolute;
      top: 0;
      right: -1px;
      width: 2px;
      height: 150px;
      background: linear-gradient(var(--color-fw-lab), transparent);
      content: "";
    }

    .lab-index {
      color: #716689;
      font: 10.5px var(--font-mono);
      letter-spacing: 0.14em;
    }

    .lab-lead {
      max-width: none;
    }

    .lab-kicker {
      margin: 0 0 9px;
      color: var(--color-fw-lab);
      font: 600 11px var(--font-mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .lab-kicker::before {
      margin-right: 7px;
      content: \"◆\";
    }

    .lab-title {
      max-width: 250px;
      margin: 0;
      color: #f3efff;
      font: 620 30px/0.95 var(--font-display);
      letter-spacing: -0.045em;
    }

    .lab-copy {
      margin: 14px 0 0;
      color: #9189a4;
      font-size: 13px;
      line-height: 1.65;
    }

    .lab-copy code {
      color: #c4b5fd;
      font: 11.5px var(--font-mono);
    }

    .lab-copy em {
      color: #d8d1e7;
      font-style: normal;
    }

    .toolbar {
      display: grid;
      gap: 7px;
      margin-top: auto;
    }

    .toolbar::before {
      margin-bottom: 2px;
      color: #625a76;
      font: 10px var(--font-mono);
      letter-spacing: 0.12em;
      content: \"PALETTE PRESETS\";
    }

    .toolbar button {
      position: relative;
      display: grid;
      grid-template-columns: 48px 1fr 12px;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 9px 10px;
      border: 1px solid #2c2739;
      border-radius: 2px;
      background: #11101a;
      color: #aaa2b9;
      font: 520 12.5px var(--font-sans);
      text-align: left;
      cursor: pointer;
      transition:
        border-color 120ms,
        background 120ms,
        color 120ms;
    }

    .toolbar button::after {
      justify-self: end;
      color: #4f485f;
      content: \"↗\";
    }

    .toolbar button:hover {
      border-color: #5f527b;
      color: #eee9f8;
    }

    .toolbar button[aria-pressed=\"true\"] {
      border-color: var(--color-fw-lab);
      background: color-mix(in srgb, var(--color-fw-lab) 12%, #11101a);
      color: #f4f0ff;
      box-shadow: inset 3px 0 0 var(--color-fw-lab);
    }

    .toolbar button[aria-pressed=\"true\"]::after {
      color: var(--color-fw-lab);
      content: \"●\";
    }

    .toolbar .swatch {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      height: 16px;
      overflow: hidden;
      border: 1px solid #4b435b;
    }

    .toolbar .swatch span {
      border-right: 1px solid rgba(255, 255, 255, 0.18);
    }

    .toolbar .swatch span:last-child {
      border-right: 0;
    }

    .fill-label {
      display: grid;
      grid-template-columns: 1fr 36px;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
      padding-top: 13px;
      border-top: 1px solid #2b2637;
      color: #aaa2b9;
      font: 11px var(--font-mono);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .toolbar input[type=\"color\"] {
      width: 36px;
      height: 27px;
      padding: 2px;
      border: 1px solid #50475f;
      border-radius: 2px;
      background: #11101a;
      cursor: pointer;
    }

    .lab-hint {
      color: #61596f;
      font: 11px/1.5 var(--font-mono);
    }
    .lab-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      grid-template-rows: 31px minmax(0, 1fr);
      min-width: 0;
      min-height: 0;
      background: #080b12;
    }

    .stage-head {
      display: flex;
      grid-column: 1;
      align-items: center;
      justify-content: space-between;
      padding: 0 11px;
      border-bottom: 1px solid #252b39;
      background: #0d1119;
      color: #626d80;
      font: 10.5px var(--font-mono);
      letter-spacing: 0.11em;
    }


    /* The `.sheetwrite` wrapper carries the CSS-var theme; #app fills it. */
    .stage {
      display: flex;
      grid-column: 1;
      grid-row: 2;
      min-width: 0;
      min-height: 0;
      flex-direction: column;
      border: 8px solid #080b12;
      border-top-width: 6px;
      box-shadow: inset 0 0 0 1px #2b3140;
    }

    #app {
      flex: 1;
      min-height: 0;
    }

    #stage .sheetwrite-tabbar {
      font: 12.5px var(--font-sans);
    }

    #stage .sheetwrite-tab-active {
      background: color-mix(in srgb, var(--color-fw-lab) 14%, transparent);
      color: #8b5cf6;
      box-shadow: inset 0 -2px 0 var(--color-fw-lab);
    }

    #stage .sheetwrite-tab:hover:not(.sheetwrite-tab-active) {
      background: color-mix(in srgb, var(--color-fw-lab) 8%, transparent);
    }

    .lab-panel {
      grid-column: 2;
      grid-row: 1 / 3;
      overflow-y: auto;
      padding: 18px 16px;
      border-left: 1px solid #252b39;
      background: #0b0f17;
      color: #7f899c;
      font-size: 12px;
      line-height: 1.6;
    }

    .lab-panel::before {
      display: block;
      margin-bottom: 19px;
      padding-bottom: 8px;
      border-bottom: 1px solid #262d3c;
      color: #5c6679;
      font: 10px var(--font-mono);
      letter-spacing: 0.13em;
      content: \"INSPECTOR / THEME.JSON\";
    }

    .lab-panel h2 {
      margin: 0 0 5px;
      color: #e7eaf1;
      font: 600 12px var(--font-display);
    }

    .lab-panel h2 + p {
      margin: 0 0 11px;
    }

    .lab-panel p:last-child {
      margin-bottom: 0;
    }

    .lab-panel code {
      color: #c4b5fd;
      font: 10.5px var(--font-mono);
    }

    .lab-panel pre {
      margin: 0 0 20px;
      padding: 10px 11px;
      overflow-x: auto;
      border: 1px solid #2b3242;
      border-radius: 2px;
      background: #070a10;
      color: #b8a7ee;
      font: 10.5px/1.7 var(--font-mono);
      box-shadow: inset 3px 0 0 #4c3b70;
    }

    @media (max-width: 980px) {
      .lab-console {
        grid-template-columns: 250px minmax(0, 1fr);
      }
      .lab-body {
        grid-template-columns: minmax(0, 1fr);
      }
      .lab-panel {
        display: none;
      }
    }

    @media (max-width: 700px) {
      .lab-console {
        grid-template-columns: 1fr;
        grid-template-rows: auto minmax(0, 1fr);
      }
      .lab-header {
        gap: 10px;
        max-height: 225px;
        padding: 12px 14px;
        border-right: 0;
        border-bottom: 1px solid #29233d;
      }
      .lab-title {
        font-size: 22px;
      }
      .lab-copy,
      .lab-index,
      .lab-hint {
        display: none;
      }
      .toolbar {
        grid-template-columns: repeat(3, 1fr);
        margin-top: 0;
      }
      .toolbar::before,
      .fill-label {
        display: none;
      }
    }
  </style>
</Layout>

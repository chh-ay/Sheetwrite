---
import ReactWorkbook from "@/components/ReactWorkbook";
import ShowcasePage from "@/components/ShowcasePage.astro";
---

<ShowcasePage
  active="react"
  eyebrow="REACT / ANALYTICS WORKBOOK"
  title="Turn 100,000 sales rows into an operating view."
  description="A production-shaped React shell over Sheetwrite's Rust/WASM engine: edit cells, search, sort, filter, aggregate, export, and control renderer selection through ordinary component state."
  packageName="@sheetwrite/react"
  guide="/docs/frameworks/react/"
  sourcePath="docs/src/components/ReactWorkbook.tsx"
  proof={[
    { icon: "database", title: "Bulk ingest", detail: "100,000 columnar rows enter WASM in one pass." },
    { icon: "search", title: "Query engine", detail: "Search, sort, filter, and aggregate use the real Grid API." },
    { icon: "monitor", title: "Renderer control", detail: "Canvas and Worker selection flows through adapter props." },
    { icon: "workflow", title: "React events", detail: "Transactions surface through callbacks and imperative refs." },
  ]}
>
  <ReactWorkbook client:only="react" />
</ShowcasePage>

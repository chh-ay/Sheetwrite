---
import DemoHeader from "@/components/DemoHeader.astro";
import ReactWorkbook from "@/components/ReactWorkbook";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Sheetwrite — React analytics workbook"
  description="100,000 rows in the Rust/WASM columnar store: search, typed filters, multi-key sort, whole-column aggregates, and XLSX export from React."
  active="react"
>
  <DemoHeader
    accent="var(--color-fw-react)"
    kicker="React adapter"
    title="Analytics workbook — 100,000 rows"
  >
    Search, filters, sorting, conditional formatting, and Sum/Avg all run against 100,000 rows in
    the Rust store. Change <strong>Highlight</strong> to swap a workbook rule, or edit any cell to
    see the adapter update immediately.
  </DemoHeader>
  <div id="app">
    <ReactWorkbook client:only="react" />
  </div>

  <style is:global>
    #app {
      flex: 1;
      min-height: 0;
    }
    #app > astro-island,
    #app > astro-island > .example-shell,
    #app > .example-shell {
      display: flex;
      flex-direction: column;
      height: 100%;
    }
  </style>
</Layout>

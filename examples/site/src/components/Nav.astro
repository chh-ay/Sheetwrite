---
// Shared example switcher, rendered at the top of every page.
interface Props {
  active: string;
}

const { active } = Astro.props;

const links = [
  { slug: "vanilla", name: "Vanilla", tagline: "Google-Sheets-style shell, cross-sheet formulas" },
  { slug: "theming", name: "Theming", tagline: "Custom renderers, runtime themes" },
  { slug: "react", name: "React", tagline: "100k-row analytics: search, filters, aggregates" },
  { slug: "vue", name: "Vue", tagline: "1M-row streaming datasource, event/sync pipeline" },
  { slug: "svelte", name: "Svelte", tagline: "Formula workbook + composable shell pieces" },
];

const current = links.find((link) => link.slug === active);
---

<nav class="sw-nav" aria-label="Sheetwrite examples">
  <a class="sw-brand" href="/">Sheetwrite</a>
  {
    links.map((link) => (
      <a href={`/${link.slug}/`} aria-current={link.slug === active ? "page" : "false"} title={link.tagline}>
        {link.name}
      </a>
    ))
  }
  <span class="sw-tagline">{current?.tagline}</span>
</nav>

<style>
  .sw-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    background: #0f172a;
    color: #e2e8f0;
    font: 13px/1.4 system-ui, sans-serif;
    flex: none;
  }
  .sw-brand {
    font-weight: 700;
    margin-right: 10px;
    color: inherit;
    text-decoration: none;
  }
  .sw-nav a:not(.sw-brand) {
    padding: 4px 12px;
    border-radius: 6px;
    color: inherit;
    text-decoration: none;
  }
  .sw-nav a:not(.sw-brand):hover {
    background: #1e293b;
  }
  .sw-nav a[aria-current="page"] {
    background: #e2e8f0;
    color: #0f172a;
    font-weight: 600;
  }
  .sw-tagline {
    margin-left: auto;
    opacity: 0.7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

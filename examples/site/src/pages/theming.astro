---
import Nav from "../components/Nav.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sheetwrite — theming &amp; custom renderers</title>
  </head>
  <body>
    <Nav active="theming" />
    <header>
      <strong>Sheetwrite</strong> — live theming, a custom badge renderer, and per-cell fill styling.
      <div class="toolbar">
        <button type="button" id="theme-light" aria-pressed="true">Light</button>
        <button type="button" id="theme-dark" aria-pressed="false">Dark</button>
        <button type="button" id="theme-brand" aria-pressed="false">Brand</button>
        <label>
          Cell fill
          <input type="color" id="cell-fill" value="#ffe08a" />
        </label>
      </div>
    </header>
    <div class="stage sheetwrite" id="stage">
      <div id="app"></div>
    </div>

    <script>
      import "../lib/theming";
    </script>

    <style is:global>
      html,
      body {
        margin: 0;
        height: 100%;
        font-family: system-ui, sans-serif;
      }
      body {
        display: flex;
        flex-direction: column;
      }
      header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 8px 12px;
        border-bottom: 1px solid #e5e5e5;
        font: 13px/1.4 system-ui, sans-serif;
        color: #333;
      }
      header strong {
        color: #111;
      }
      .toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .toolbar button {
        font: inherit;
        padding: 4px 10px;
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        background: #fafafa;
        color: #222;
        cursor: pointer;
      }
      .toolbar button:hover {
        background: #f0f0f0;
      }
      .toolbar button[aria-pressed="true"] {
        border-color: #2563eb;
        background: #2563eb;
        color: #fff;
      }
      .toolbar label {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .toolbar input[type="color"] {
        width: 28px;
        height: 24px;
        padding: 0;
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        background: none;
        cursor: pointer;
      }
      /* The `.sheetwrite` wrapper carries the CSS-var theme; #app fills it. */
      .stage {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
      }
      #app {
        flex: 1;
        min-height: 0;
      }
    </style>
  </body>
</html>

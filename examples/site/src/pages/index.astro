---
import Layout from "../layouts/Layout.astro";

const cards = [
  {
    slug: "vanilla",
    accent: "var(--color-fw-vanilla)",
    kicker: "Vanilla · imperative core",
    name: "Google-Sheets-style workbook",
    body: "A full Sheets clone over the headless API: custom toolbar on grid.actions, formula bar and name box, cross-sheet formulas, frozen panes, zoom, CSV import/export.",
    stat: "100k rows",
    chips: ["grid.actions", "parseCellInput", "fromCsv", "setFrozen"],
  },
  {
    slug: "theming",
    accent: "var(--color-fw-lab)",
    kicker: "Vanilla · style lab",
    name: "Theming & custom renderers",
    body: "Runtime theme switching across three palettes, a canvas badge cell renderer, and store-backed per-cell fills painted straight into the render pass.",
    stat: "3 palettes",
    chips: ["setTheme", "CellRenderer.canvas", "applyTransaction"],
  },
  {
    slug: "react",
    accent: "var(--color-fw-react)",
    kicker: "React adapter",
    name: "Analytics workbook",
    body: "100,000 eager rows in the Rust store. Search with live match counts, typed column filters, multi-key sort, whole-column Sum/Avg — every scan runs in Rust.",
    stat: "100k rows",
    chips: ["worker renderer", "overscan", "aggregate", "exportXlsx"],
  },
  {
    slug: "vue",
    accent: "var(--color-fw-vue)",
    kicker: "Vue adapter",
    name: "Streaming sync console",
    body: "A million virtual rows behind a latency-simulated paged datasource, a live grid-event pipeline, and the getDirty/markClean server-acknowledgement flow.",
    stat: "1M rows",
    chips: ["DataSource", "getDirty", "markClean", "search"],
  },
  {
    slug: "svelte",
    accent: "var(--color-fw-svelte)",
    kicker: "Svelte 5 adapter",
    name: "Formula workbook + shell",
    body: "500 =SUM row formulas plus cross-sheet Summary aggregates, composed from framework-neutral @sheetwrite/core/shell pieces via bind:grid + $effect.",
    stat: "live =SUM",
    chips: ["core/shell", "renderers", "commitReason", "insertRows"],
  },
];

const stats = [
  { value: "1,000,000", label: "virtual rows, paged on scroll" },
  { value: "100,000", label: "eager rows, scanned in Rust" },
  { value: "=SUM(Model!F:F)", label: "cross-sheet formulas, live recalc" },
  { value: "3 + 1", label: "adapters — React, Vue, Svelte, vanilla" },
];
---

<Layout
  title="Sheetwrite — canvas spreadsheet engine for the web"
  description="A canvas spreadsheet and data grid backed by a Rust/WASM columnar engine, with an imperative core and React, Vue, and Svelte adapters."
>
  <main class="min-h-0 flex-1 overflow-y-auto">
    <!-- ── Hero ─────────────────────────────────────────────────────── -->
    <section class="grid-paper hero relative overflow-hidden border-b border-ink-800">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-[1400px] gap-12 px-6 pt-14 pb-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="hero-badge">Open source · Rust + WASM · Canvas</p>
          <h1 class="hero-title">
            CELLS.<br />
            WITHOUT.<br />
            <em>LIMITS.</em>
          </h1>
          <div class="hero-copy-row">
            <span aria-hidden="true">↳</span>
            <p>
              Sheetwrite is the spreadsheet engine hiding beneath your product: a million-row
              Rust store, a single canvas, real formulas, and adapters that stay out of the way.
            </p>
          </div>
          <div class="hero-actions">
            <a href="/vanilla/" class="hero-primary">Launch workbook</a>
            <a href="/react/" class="hero-secondary">Stress-test 100k rows</a>
          </div>
        </div>

        <!-- Source readout -->
        <figure class="code-panel" aria-label="Install and render Sheetwrite">
          <figcaption class="code-titlebar">
            <span>React source</span>
            <span class="ml-auto font-mono text-[11px] text-ink-500">grid.tsx</span>
          </figcaption>
          <pre
            class="code-body"><code><span class="c">// core + WASM arrive transitively</span>
<span class="k">$</span> bun add <span class="s">@sheetwrite/react</span>

<span class="k">import</span> {"{"} Sheetwrite {"}"} <span class="k">from</span> <span class="s">"@sheetwrite/react"</span>;
<span class="k">import</span> <span class="s">"@sheetwrite/react/styles.css"</span>;

&lt;<span class="t">Sheetwrite</span>
  <span class="a">columns</span>={"{"}[
    {"{"} key: <span class="s">"name"</span>, title: <span class="s">"Name"</span> {"}"},
    {"{"} key: <span class="s">"price"</span>,
      title: <span class="s">"Price"</span>, type: <span class="s">"currency"</span> {"}"},
  ]{"}"}
  <span class="a">defaultRows</span>={"{"}products{"}"}
  <span class="a">height</span>={"{"}500{"}"}
  <span class="a">onGridChange</span>={"{"}(event) =&gt; event.source === <span class="s">"local"</span> &amp;&amp; save(event.transaction.patches){"}"}
/&gt;</code></pre>
        </figure>
      </div>

      <!-- Stats strip -->
      <div class="relative border-t border-ink-800/80 bg-ink-950/60">
        <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-px px-6 py-6 sm:grid-cols-4">
          {
            stats.map((stat) => (
              <div class="px-2">
                <dt class="order-2 mt-1 text-xs text-ink-400">{stat.label}</dt>
                <dd class="m-0 font-mono text-[17px] font-semibold text-brand-300">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ── Demo cards ───────────────────────────────────────────────── -->
    <section class="demo-index mx-auto max-w-[1280px] px-5 py-14">
      <div class="demo-index-head">
        <h2>Choose your integration surface.</h2>
        <p>Five complete examples, from the imperative core to framework adapters.</p>
      </div>
      <div class="demo-grid">
        {
          cards.map((card) => (
            <a href={`/${card.slug}/`} class="demo-card" style={`--accent: ${card.accent}`}>
              <div class="flex items-center justify-between gap-3">
                <p class="m-0 font-mono text-[12px] tracking-wide uppercase" style="color: var(--accent)">
                  {card.kicker}
                </p>
                <span class="demo-stat">{card.stat}</span>
              </div>
              <h3 class="mt-3 mb-0 font-display text-[17px] font-semibold text-ink-50">
                {card.name}
              </h3>
              <p class="mt-2 mb-0 text-[14px] leading-relaxed text-ink-300">{card.body}</p>
              <ul class="demo-apis">
                {card.chips.map((chip) => (
                  <li>{chip}</li>
                ))}
              </ul>
              <span class="demo-card-cta">Open demo →</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="engine-section">
      <div class="engine-intro">
        <p class="engine-eyebrow">Inside Sheetwrite</p>
        <h2>Why Rust?</h2>
        <p class="engine-lead">
          Spreadsheet workloads grow by rows and columns, not by components. Sheetwrite keeps the
          hot path in a columnar Rust/WASM engine so larger datasets do not create larger
          JavaScript object graphs.
        </p>
      </div>
      <div class="engine-capabilities">
        <article>
          <h3>Data stays columnar.</h3>
          <p>Typed columns, bulk ingest, sparse styles, and dirty tracking keep scans compact and cache-friendly.</p>
        </article>
        <article>
          <h3>Queries cross the boundary once.</h3>
          <p>Sort, filter, search, formulas, and aggregates execute in Rust; the adapter receives the result, not every intermediate row.</p>
        </article>
        <article>
          <h3>The browser paints a window.</h3>
          <p>Only visible cells and overscan reach the canvas, so DOM size stays flat whether the sheet has hundreds or millions of rows.</p>
        </article>
      </div>
    </section>

    <footer class="border-t border-ink-800">
      <div class="mx-auto max-w-6xl px-6 py-6 text-xs text-ink-400">
        <p class="m-0">Sheetwrite — MIT licensed. Built in Rust, rendered on canvas.</p>
      </div>
    </footer>
  </main>

  <style>
    .hero {
      background-color: #070a10;
      background-size: 36px 36px;
    }

    .hero::after {
      position: absolute;
      inset: 0;
      border: 1px solid transparent;
      background: linear-gradient(90deg, transparent 49.92%, rgba(142, 156, 181, 0.08) 50%, transparent 50.08%);
      pointer-events: none;
      content: "";
    }

    .hero-glow {
      position: absolute;
      inset: -30% -20% auto 35%;
      height: 120%;
      background:
        radial-gradient(40% 55% at 70% 35%, rgba(16, 185, 129, 0.15), transparent 72%),
        radial-gradient(28% 40% at 28% 70%, rgba(34, 211, 238, 0.07), transparent 75%);
      pointer-events: none;
    }


    .hero-badge {
      margin: 0 0 17px;
      color: #78869d;
      font: 11px var(--font-mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .hero-title {
      margin: 0;
      color: #f4f6fa;
      font: 680 clamp(62px, 8vw, 112px) / 0.76 var(--font-display);
      letter-spacing: -0.075em;
    }

    .hero-title em {
      position: relative;
      color: var(--color-brand-400);
      font-style: normal;
      text-shadow: 0 0 40px rgba(16, 185, 129, 0.2);
    }

    .hero-copy-row {
      display: grid;
      grid-template-columns: 24px minmax(0, 520px);
      gap: 8px;
      margin-top: 30px;
      color: #647089;
    }

    .hero-copy-row > span {
      color: var(--color-brand-400);
      font-family: var(--font-mono);
    }

    .hero-copy-row p {
      margin: 0;
      font-size: 15px;
      line-height: 1.65;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      margin-top: 25px;
    }

    .hero-actions a {
      display: inline-flex;
      align-items: center;
      gap: 16px;
      min-height: 42px;
      padding: 0 17px;
      border: 1px solid #344057;
      font-size: 12px;
      font-weight: 650;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition:
        background 120ms,
        color 120ms,
        border-color 120ms;
    }


    .hero-primary {
      background: var(--color-brand-400);
      color: #04100d;
      border-color: var(--color-brand-300) !important;
    }

    .hero-primary:hover {
      background: var(--color-brand-300);
    }

    .hero-secondary {
      margin-left: -1px;
      background: #0a0e16;
      color: #b8c1d1;
    }

    .hero-secondary:hover {
      border-color: var(--color-brand-500);
      color: var(--color-brand-300);
    }

    .code-panel {
      position: relative;
      margin: 0;
      overflow: hidden;
      border: 1px solid #344057;
      border-radius: 0;
      background: rgba(7, 10, 16, 0.92);
      box-shadow:
        10px 10px 0 #0c1320,
        11px 11px 0 #283247;
    }

    .code-panel::before {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 34px;
      width: 1px;
      background: #1f2939;
      content: "";
    }

    .code-titlebar {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 9px 11px;
      border-bottom: 1px solid #293347;
      background: #0d121d;
      color: #758198;
      font: 10.5px var(--font-mono);
      letter-spacing: 0.08em;
    }


    .code-body {
      margin: 0;
      padding: 18px 18px 18px 50px;
      overflow-x: auto;
      color: var(--color-ink-200);
      font: 13px / 1.72 var(--font-mono);
    }

    .code-body .c {
      color: #4b5870;
    }
    .code-body .k {
      color: #c4b5fd;
    }
    .code-body .s {
      color: var(--color-brand-300);
    }
    .code-body .t {
      color: #7dd3fc;
    }
    .code-body .a {
      color: #fbbf24;
    }

    .demo-index-head {
      display: grid;
      grid-template-columns: 1fr minmax(300px, 560px);
      align-items: end;
      gap: 24px;
      margin-bottom: 25px;
      padding-bottom: 17px;
      border-bottom: 1px solid #263044;
    }

    .demo-index-head p {
      margin: 0;
      color: #8490a6;
      font-size: 14px;
      line-height: 1.5;
      text-align: right;
    }

    .demo-index-head h2 {
      margin: 0;
      color: #f0f2f7;
      font: 620 32px/1 var(--font-display);
      letter-spacing: -0.035em;
    }

    .demo-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      border-top: 1px solid #2a3448;
      border-left: 1px solid #2a3448;
    }

    .demo-card {
      position: relative;
      display: flex;
      grid-column: span 2;
      min-height: 252px;
      flex-direction: column;
      padding: 20px;
      overflow: hidden;
      border: 0;
      border-right: 1px solid #2a3448;
      border-bottom: 1px solid #2a3448;
      border-radius: 0;
      background: #0a0f18;
      color: inherit;
      text-decoration: none;
      transition:
        background 140ms,
        box-shadow 140ms;
    }

    .demo-card::before {
      position: absolute;
      top: 0;
      left: 0;
      width: 54px;
      height: 2px;
      background: var(--accent, var(--color-brand-400));
      content: "";
    }

    .demo-card:nth-child(1),
    .demo-card:nth-child(2) {
      grid-column: span 3;
    }

    a.demo-card:hover {
      z-index: 1;
      background: #0e1521;
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 52%, transparent);
    }

    a.demo-card h3 {
      font-size: 21px;
      letter-spacing: -0.025em;
    }

    .demo-stat {
      color: var(--accent);
      font: 11px var(--font-mono);
      letter-spacing: 0.05em;
    }

    .demo-apis {
      display: flex;
      flex-wrap: wrap;
      gap: 3px 0;
      margin: 14px 0 0;
      padding: 0;
      color: #78849a;
      font: 11px var(--font-mono);
      list-style: none;
    }

    .demo-apis li + li::before {
      padding: 0 6px;
      color: #3e4a5f;
      content: "/";
    }

    .demo-card-cta {
      margin-top: auto;
      padding-top: 16px;
      color: var(--accent);
      font: 11px var(--font-mono);
      letter-spacing: 0.08em;
      opacity: 1;
    }

    .engine-section {
      display: grid;
      grid-template-columns: minmax(300px, 0.75fr) minmax(480px, 1.25fr);
      gap: 80px;
      max-width: 1280px;
      margin: 0 auto 64px;
      padding: 60px 20px 0;
      border-top: 1px solid #2a3448;
    }

    .engine-eyebrow {
      margin: 0 0 18px;
      color: var(--color-brand-300);
      font: 600 12px var(--font-mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .engine-intro h2 {
      margin: 0;
      color: var(--color-ink-50);
      font: 630 56px/0.95 var(--font-display);
      letter-spacing: -0.055em;
    }

    .engine-lead {
      max-width: 490px;
      margin: 24px 0 0;
      color: var(--color-ink-300);
      font-size: 16px;
      line-height: 1.7;
    }

    .engine-capabilities {
      border-top: 1px solid #2a3448;
    }

    .engine-capabilities article {
      display: grid;
      grid-template-columns: minmax(190px, 0.7fr) 1fr;
      gap: 30px;
      padding: 24px 0;
      border-bottom: 1px solid #2a3448;
    }

    .engine-capabilities h3 {
      margin: 0;
      color: var(--color-ink-50);
      font: 600 18px/1.3 var(--font-display);
    }

    .engine-capabilities p {
      margin: 0;
      color: var(--color-ink-300);
      font-size: 14px;
      line-height: 1.65;
    }

    @media (max-width: 850px) {
      .hero-title {
        font-size: clamp(58px, 16vw, 92px);
      }
      .demo-grid {
        grid-template-columns: 1fr;
      }
      .demo-card,
      .demo-card:nth-child(1),
      .demo-card:nth-child(2) {
        grid-column: auto;
      }
      .engine-section,
      .engine-capabilities article {
        grid-template-columns: 1fr;
        gap: 28px;
      }
      .demo-index-head p {
        text-align: left;
      }
      .demo-index-head {
        grid-template-columns: 1fr;
      }
      .demo-index-head span {
        display: none;
      }
    }
  </style>
</Layout>

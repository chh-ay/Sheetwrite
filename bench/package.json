{
  "name": "@sheetwrite/bench",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Performance comparison benchmarks: Sheetwrite vs Handsontable.",
  "scripts": {
    "bench:data": "bun run src/data-bench.ts",
    "bench:data:smoke": "bun run src/data-bench.ts --smoke",
    "bench:range": "bun run src/range-bench.ts",
    "bench:range:smoke": "bun run src/range-bench.ts --smoke",
    "bench:paged": "bun run src/paged-bench.ts",
    "bench:paged:smoke": "bun run src/paged-bench.ts --smoke",
    "bench:prefetch": "bun run src/datasource-prefetch-bench.ts",
    "bench:billion-cell": "bun run src/billion-cell-bench.ts",
    "bench:formula": "bun run src/formula-bench.ts",
    "bench:view-index": "bun run src/view-index-bench.ts",
    "bench:formula:smoke": "bun run src/formula-bench.ts --smoke",
    "bench:resource": "bun run src/resource-bench.ts",
    "bench:resource:smoke": "bun run src/resource-bench.ts --smoke",
    "bench:render:prepare": "cd .. && bun run build:wasm && bun run --filter '@sheetwrite/core' build",
    "bench:render": "bun run src/render-driver.ts",
    "bench:render:diagnostic": "bun run src/render-driver.ts --scenario-set diagnostic --engine sheetwrite",
    "bench:render:smoke": "bun run src/render-driver.ts --smoke",
    "bench:render:validate": "bun run src/render-driver.ts --validate results/render-results.json --gate-mode full",
    "bench:xlsx": "bun run src/xlsx-bench.ts",
    "bench:xlsx:smoke": "bun run src/xlsx-bench.ts --smoke",
    "bench:verify": "bun run src/verify.ts",
    "bench:check": "bun run src/check.ts",
    "bench:baseline:candidate": "bun run src/generate-baseline.ts",
    "test:gates": "bun test test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bench:render:scale": "bun run src/render-driver.ts --rows 1000,10000,100000,1000000 --rounds 10 --compact-samples --output results/render-scale.json --markdown-output results/render-scale.md"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@sheetwrite/core": "workspace:*",
    "@sheetwrite/wasm": "workspace:*",
    "handsontable": "^18.0.0"
  }
}

{
  "name": "@sheetwrite/svelte",
  "version": "0.1.0",
  "type": "module",
  "description": "Svelte adapter for Sheetwrite.",
  "license": "MIT",
  "keywords": [
    "spreadsheet",
    "data-grid",
    "svelte",
    "canvas"
  ],
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "src",
    "styles.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run typecheck",
    "prepublishOnly": "bun run build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "dependencies": {
    "@sheetwrite/core": "workspace:*"
  },
  "devDependencies": {
    "svelte-check": "^4.7.2",
    "typescript": "^6"
  }
}

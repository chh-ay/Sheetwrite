{
  "name": "@sheetwrite/react",
  "version": "0.1.0",
  "type": "module",
  "description": "React adapter for Sheetwrite.",
  "license": "MIT",
  "keywords": [
    "spreadsheet",
    "data-grid",
    "react",
    "canvas"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@sheetwrite/core": "workspace:*"
  }
}

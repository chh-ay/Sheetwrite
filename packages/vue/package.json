{
  "name": "@sheetwrite/vue",
  "version": "0.0.0",
  "type": "module",
  "description": "Vue adapter for Sheetwrite.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "dependencies": {
    "@sheetwrite/core": "workspace:*"
  }
}

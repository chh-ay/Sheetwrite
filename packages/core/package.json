{
  "name": "@sheetwrite/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Framework-agnostic, canvas-rendered spreadsheet grid core.",
  "license": "MIT",
  "sideEffects": [
    "*.css",
    "./dist/xlsx-backend.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx-backend.d.ts",
      "default": "./dist/xlsx-backend.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sheetwrite/wasm": "workspace:*",
    "write-excel-file": "^4.1.1"
  }
}

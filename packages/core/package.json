{
  "name": "@sheetwrite/core",
  "version": "0.3.1",
  "type": "module",
  "description": "Framework-agnostic, canvas-rendered spreadsheet grid core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chh-ay/sheetwrite.git",
    "directory": "packages/core"
  },
  "homepage": "https://sheetwrite.vercel.app/",
  "bugs": {
    "url": "https://github.com/chh-ay/sheetwrite/issues"
  },
  "keywords": [
    "spreadsheet",
    "data-grid",
    "canvas",
    "wasm",
    "excel",
    "typescript"
  ],
  "sideEffects": [
    "*.css",
    "./dist/worker.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./browser": {
      "types": "./dist/indexeddb.d.ts",
      "default": "./dist/indexeddb.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "default": "./dist/shell.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./styles.css": "./styles.css",
    "./shell.css": "./shell.css"
  },
  "files": [
    "dist",
    "styles.css",
    "shell.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json && rm -f dist/types/*.js dist/types/*.js.map",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sheetwrite/wasm": "workspace:*"
  }
}
